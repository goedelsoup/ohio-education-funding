{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ohio education funding — corpus node",
  "description": "One node in .yidam/corpus/<class>/. Every node is an instance of its directory's ontology class, carries prose with inline [verified]/[inference]/[open] claim tags, and declares at least one outgoing link as a list — never as a paragraph.",
  "type": "object",
  "properties": {
    "class": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 450,
      "pattern": "^(?!.*\\]\\()"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "properties": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "links": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "relationship"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "string"
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "was": {
            "type": "string",
            "minLength": 1
          },
          "now": {
            "type": "string",
            "minLength": 1
          },
          "found_by": {
            "type": "string",
            "minLength": 1
          },
          "reach": {
            "type": "string"
          }
        },
        "required": [
          "was",
          "now",
          "found_by"
        ],
        "additionalProperties": false
      }
    },
    "unfilled": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "field"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "class",
    "label",
    "summary",
    "description",
    "links"
  ],
  "additionalProperties": false
}
