{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ohio education funding — corpus ontology class",
  "description": "One class definition, .yidam/corpus/<class>.ont.yml. Declares what a kind of node is, the properties it may carry, and the relationships it may enter into.",
  "type": "object",
  "properties": {
    "class": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "foundational_type": {
      "type": "object",
      "properties": {
        "ontology": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "ontology",
        "type"
      ],
      "additionalProperties": false
    },
    "properties": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "type",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relationship": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "relationship",
          "target",
          "direction",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "class",
    "label",
    "description"
  ],
  "additionalProperties": false
}
