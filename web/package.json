{
  "name": "ohio-education-funding-web",
  "private": true,
  "type": "module",
  "description": "The interface layer for the Ohio school funding model: district, statewide, and scenario views over the crates/bundle feed.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "schemas": "node scripts/schemas.ts",
    "check:dist": "node scripts/check-dist-links.ts",
    "corpus:report": "node scripts/corpus-report.ts",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.1.2",
    "astro": "^7.2.0",
    "linkedom": "^0.18.13",
    "rehype-sanitize": "^6.0.0",
    "satori": "^0.29.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@11.13.1",
  "dependencies": {
    "@observablehq/plot": "^0.6.17"
  }
}
