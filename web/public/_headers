# Response headers for the static host. Astro copies `public/` into `dist/` verbatim, and
# Cloudflare Pages reads this file from the deploy root rather than serving it.
#
# Two rules about the syntax that are easy to get wrong: matches are cumulative rather than
# first-wins, so the `/*` block below applies to everything and the specific blocks add to it;
# and the two-space indent under each path is load-bearing.

/*
  # Every route on this site is extensionless — `build.format: "file"` emits
  # `district/043786.html` and Pages serves it at `/district/043786`. `_headers` matches the
  # *request* path, so a `/*.html` rule matches nothing at all; the previous one silently did,
  # and a deploy left stale HTML at the edge pointing at asset hashes the next deploy had purged.
  # The document rule therefore lives here, on the pattern that actually matches, and the two
  # blocks below override it for the paths that may be cached.
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  # `style-src` needs 'unsafe-inline' for two things, both inside markup this repository generates:
  # style *attributes* (the stacked bar widths and the percentile marker in `src/lib/district.ts`)
  # and the scoped `<style>` element Observable Plot writes into every SVG it renders. `script-src`
  # stays strict, which is the half that matters: no inline script, no event-handler attributes,
  # and nothing fetched off-origin.
  #
  # `form-action 'self'` rather than 'none': the header's search box is a real `<form>` so that it
  # still works with scripting off, and it submits to `/search`.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'

# Vite content-hashes these filenames, so a changed file is a changed URL and the old one can be
# held forever. The `.js.map` beside the bundle is hashed too, and is deployed on purpose:
# `astro.config.mjs` turns sourcemaps on so the arithmetic stays readable in the browser.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The data files are *not* hashed — they are fetched and linked at fixed paths — so they cannot be
# immutable. A deploy purges the edge, so 300s bounds only how long a returning browser can hold a
# superseded copy. If that ever needs to be zero, the fix is a hashed path, not a shorter max-age.
#
# `panel.json` matters most of the three: it is what the scenario routes run the formula over, and
# a stale one against a fresh page is the state the runtime verification gate exists to catch.
/data/*
  Cache-Control: public, max-age=300, must-revalidate

/search-index.json
  Cache-Control: public, max-age=300, must-revalidate
