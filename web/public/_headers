# Response headers for the static host. Astro copies `public/` into `dist/` verbatim, and
# Cloudflare Pages reads this file from the deploy root rather than serving it.
#
# Two rules about the syntax that are easy to get wrong: matches are cumulative rather than
# first-wins, so the `/*` block below applies to everything and the specific blocks add to it;
# and the two-space indent under each path is load-bearing.

/*
  # There is deliberately NO Cache-Control here, and the absence is the whole point.
  #
  # The header of this file says matches are cumulative rather than first-wins. That is right, and
  # a `Cache-Control` on `/*` then does not do what the rule below it looks like it does: Pages
  # concatenates the two values, `/*` lands FIRST, and first is what a parser takes. Every block
  # below was defeated by this line for as long as it was here. Observed on production:
  #
  #   /_astro/…js      cache-control: public, max-age=0, must-revalidate, public, max-age=31536000, immutable
  #   /data/panel.json cache-control: public, max-age=0, must-revalidate, public, max-age=300, must-revalidate
  #
  # So `immutable` never applied to a content-hashed asset, and the reasoning about 300s against
  # 3600s below decided nothing — everything on the deploy revalidated on every request. The
  # comment that used to sit here said the blocks below "override it", which is the one thing
  # cumulative matching does not do, and it contradicted this file's own opening note.
  #
  # Documents therefore take the platform default rather than an explicit header. That is the
  # trade: the seven blocks below are now the only Cache-Control on the deploy, and each means
  # what it says. Every route here is extensionless — `build.format: "file"` emits
  # `district/043786.html` and Pages serves it at `/district/043786`, and `_headers` matches the
  # *request* path — so there is no pattern that selects documents without also selecting the
  # assets, which is why this cannot be fixed by moving the line somewhere more specific.
  #
  # This is not visible in `dist/`, in `vite preview`, or in any test that reads the artefact. It
  # is only visible in a response header, so check it there after a deploy:
  #
  #   curl -sI https://ohio-education-funding.pages.dev/_astro/<hashed>.js | grep -i cache-control
  #
  # One value, not two.
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  # `style-src` needs 'unsafe-inline' for two things, both inside markup this repository generates:
  # style *attributes* (the stacked bar widths and the percentile marker in `src/lib/district.ts`)
  # and the scoped `<style>` element Observable Plot writes into every SVG it renders. `script-src`
  # stays strict, which is the half that matters: no inline script, no event-handler attributes,
  # and nothing fetched off-origin.
  #
  # `form-action 'self'` rather than 'none': three real `<form>` elements remain — the scenario
  # controls, `/compare`'s picker and `/districts`' filter — and each suppresses its own submit in
  # script. With scripting off there is no listener to suppress it, so Enter in a filter field
  # submits to the page's own URL. 'none' would block that with a violation rather than let it
  # reload harmlessly, which is a worse no-JS experience for no gain: nothing here posts anywhere.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'

# Vite content-hashes these filenames, so a changed file is a changed URL and the old one can be
# held forever. The `.js.map` beside the bundle is hashed too, and is deployed on purpose:
# `astro.config.mjs` turns sourcemaps on so the arithmetic stays readable in the browser.
#
# The maths font rides this rule and needed no block of its own. `tokens/typography.css` reaches it
# with a relative `url()`, so Vite hashes it into `/_astro/` like a stylesheet — which is the whole
# reason it is imported from `src/assets/` rather than dropped in `public/`, where it would have
# been unhashed and stuck with a revalidating max-age like `/data/*`. A font is the asset that
# benefits most from `immutable`: it is fetched once, by a reader whose platform gave them nothing.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The data files are *not* hashed — they are fetched and linked at fixed paths — so they cannot be
# immutable. A deploy purges the edge, so 300s bounds only how long a returning browser can hold a
# superseded copy. If that ever needs to be zero, the fix is a hashed path, not a shorter max-age.
#
# `panel.json` matters most of the three: it is what the scenario routes run the formula over, and
# a stale one against a fresh page is the state the runtime verification gate exists to catch.
/data/*
  Cache-Control: public, max-age=300, must-revalidate

# The preview cards, and the two icons rasterized from the same mark. Not content-hashed — the
# `og:image` in each document names a fixed path — so the same rule as `/data/*` applies and
# `immutable` is not available. An hour rather than five minutes because the audience is different:
# these are fetched by unfurlers and crawlers re-checking a link that was shared once, not by a
# page recomputing the formula, and a card that is an hour stale is a card, while a stale
# `panel.json` is a wrong number.
/og/*
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=3600, must-revalidate

/icon-32.png
  Cache-Control: public, max-age=3600, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=3600, must-revalidate
