---
/**
 * The shell every page wears.
 *
 * Unlike the document this replaced, it is not inert. The figures are written into the HTML at
 * build time by `getStaticPaths` and the renderers in `src/lib/`, so a page is complete before
 * any JavaScript runs and stays complete if none ever does. `src/scripts/site.ts` adds the
 * hover layer, the theme switch, and the nominal/constant-dollar toggle on top of a page that
 * already reads correctly without them.
 */
import { contentsOf, withContents } from "../lib/contents.ts";
import { applySemantics } from "../lib/semantics.ts";
import { loadFeed } from "../lib/feed.ts";
import { groupLinks, nav, type Section } from "../lib/nav.ts";
import { ICON_VIEWBOX, ICONS } from "../lib/icons.ts";
import { modelSource } from "../lib/modelSource.ts";
import { canonicalPath, og, REPOSITORY, reportError } from "../lib/routes.ts";
import { HEIGHT, WIDTH } from "../lib/og/card.ts";
import { inlineMark } from "../lib/og/mark.ts";
import "../styles/app.css";

interface Props {
  /** The `<title>`, before the site name is appended. */
  title: string;
  /** One sentence. Used for `<meta name="description">` and for the preview card's caption. */
  description: string;
  /**
   * The preview card for this page, from the `og` table in `src/lib/routes.ts`.
   *
   * Omitting it is not an error — the page previews as the site. That is the right default for
   * `/404`, which is not about anything, and it means a route added later gets a usable preview
   * rather than none while nobody notices.
   */
  image?: string;
  /** What the card shows, for a reader who cannot see it. Falls back to the description. */
  imageAlt?: string;
  /**
   * Where this page sits in the bar, if anywhere.
   *
   * Either a group — which marks the group as holding the current page without marking any link
   * as being it, the case for every act the `Law` menu does not name — or a link. The homepage
   * passes nothing: it has no entry, by design.
   */
  section?: Section;
  /** Rendered above the page, before the slot. Used for the district sub-navigation. */
  wide?: boolean;
  /**
   * A `schema.org` object describing what this page *is*, as JSON-LD.
   *
   * Optional, and almost always omitted. Structured data is worth emitting where a machine can do
   * something with it that reading the prose would not achieve, and worth skipping everywhere
   * else: a `WebPage` object restating the `<title>` and the description two tags above it is
   * markup for its own sake, and it is the shape that goes stale without anyone noticing because
   * nothing renders it.
   *
   * `/data` is the page where it earns its place. It offers files at fixed URLs with stated media
   * types, a licence-shaped Terms section and a contract version — which is exactly a
   * `schema.org/Dataset` with its `distribution`s — and dataset search is a thing that exists and
   * indexes on this vocabulary. Nothing on this site was discoverable that way.
   *
   * Passed as an object rather than a string so the caller cannot emit invalid JSON, and
   * serialised here with `<` escaped: `JSON.stringify` will happily produce `</script>` inside a
   * string value and end the element early. `set:html` is correct for the same reason it is
   * everywhere else in this layout — the content is JSON, not markup, and Astro would otherwise
   * entity-escape the quotes into something no parser accepts.
   */
  jsonLd?: Record<string, unknown>;
  /**
   * Whether this page lists its own sections above them.
   *
   * On by default, and skipped automatically below four of them — see `contents.ts`. Set it false
   * for a page whose sections are not what a reader came for: `/compare` is two controls and their
   * own output, and a list of them is a list of the page.
   */
  contents?: boolean;
}

const {
  title,
  description,
  section,
  wide = false,
  contents = true,
  image = og.default(),
  imageAlt,
  jsonLd,
} = Astro.props;
const { bundle, verification, forecastable } = loadFeed();
/**
 * When the data dates from, and where to say it is wrong (#595).
 *
 * A journalist citing the site needs both and could find neither: the calculator's date was on its
 * catalog page alone, and the footer offered no way to report an error. The date is read from the
 * catalog entry by `modelSource`, never typed here. The maintainer is the repository's owner,
 * read off its address for the same reason.
 */
const model = modelSource(bundle.fiscal_year);
const maintainer = new URL(REPOSITORY).pathname.split("/")[1];

/**
 * This page's address, as a reader would type it.
 *
 * `Astro.url.pathname` reports the *file* being written — `build.format` is `"file"`, so that is
 * `/district/043786.html` — and both the canonical link and `og:url` have to name a URL that
 * resolves. They are computed from one value here so they cannot disagree, which they previously
 * could not have done only because there was one of them.
 */
const site = Astro.site ?? new URL("https://ohio-education-funding.pages.dev");
const canonical = new URL(canonicalPath(Astro.url.pathname), site);
const cardUrl = new URL(image, site);
/**
 * The site name, appended to every page's own title — except the home page's, whose title *is*
 * the site name. Appending it there printed "Ohio school funding — Ohio school funding" in every
 * browser tab and on every shared link to the front door (#571).
 *
 * `og:title` is read without the tab strip around it, so it carries the site name too.
 */
const SITE_NAME = "Ohio school funding";
const socialTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;

/**
 * The sections.
 *
 * The bar itself is `src/lib/nav.ts`, which computes it — part of it is read out of
 * `.yidam/corpus/`, and the checks that keep it honest want to import a structure rather than
 * parse a rendered header. This file renders what it is given and decides nothing.
 *
 * # Why `<details>` and not a menu
 *
 * A third of the end-to-end suite runs with JavaScript disabled, and this repository has already
 * decided once that a control which dies without script is worse than no control — see
 * `BasisToggle.astro`. A native disclosure needs nothing running: it opens on click, on Enter and
 * on Space, and screen readers announce its state without being told to.
 *
 * The cost is that two menus can sit open at once, because closing a sibling needs a script.
 * `site.ts` closes them when one opens, and on Escape and on a click outside — and a reader
 * without it gets two open menus rather than a menu that does not open.
 */
const NAV = nav(bundle);

/**
 * Whether a link in the bar is where the reader is.
 *
 * Two ways of being current, because the bar holds two kinds of link.
 *
 * **By path.** The class indexes under `Library` are read out of the corpus, and no fixed
 * `Section` union can name them — a class added to `.yidam/` is a link the day it lands. Comparing
 * the href to the page being rendered marks them without anything having to enumerate them.
 *
 * **By section.** A district page is not `/districts`, and it still belongs under it. `section`
 * is what a page says about where it sits rather than about what it is, and seven pages use it
 * that way.
 *
 * The `!= null` is not defensive. Most links in the bar carry no `key` at all, and a page that
 * names no section passes `undefined`; compared directly, `undefined === undefined` is true, so
 * the homepage marked `Law` and `Formula` both `aria-current="true"` — a screen reader told the
 * reader they were inside two sections of a page that is in neither.
 */
const here = canonicalPath(Astro.url.pathname);
const isCurrent = (link: { key?: Section; href: string }): boolean =>
  link.href === here || (link.key != null && link.key === section);

const checkpoints = verification.comparisons.length;
const forecasts = verification.forecasts.length;

/*
 * The page, rendered to a string before the document is written around it.
 *
 * This is what lets the table of contents be read off the page rather than declared beside it —
 * `contents.ts` explains at length why that distinction is the whole feature, and it is only
 * available here, because the layout is the one place that holds the whole body at once. The
 * pattern is Astro's own: render the slot, then `set:html` it in place of `<slot />`.
 *
 * Nothing on this site hydrates, so rendering the slot early costs nothing beyond the parse.
 */
const rendered = await Astro.slots.render("default");
const listed = contents ? withContents(rendered, contentsOf(rendered)) : rendered;
/*
 * What the markup means, decided where the whole body is in hand: which cell heads which row, what
 * each scrolling box is called, and how deep the corpus's own headings sit in the page they were
 * placed into. See `semantics.ts` for why each of those is a property of the document rather than
 * of the renderer that wrote a piece of it.
 *
 * After the contents list, so the list is walked too, and after `contentsOf` has read the headings
 * — that reads what the corpus authored, and this is what places it.
 */
const body = applySemantics(listed).html;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{socialTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* The mark. SVG for browsers, 32px PNG for the unfurlers that will not take one, 180px for
        iOS. All three are the same drawing — see `src/lib/og/mark.ts`. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/*
      What a link to this page looks like when it is pasted somewhere.

      Open Graph is read by Slack, Discord, Facebook, LinkedIn, Bluesky and — since it stopped
      reading its own — X. The three `twitter:` tags below are not redundant with it: X takes
      `og:*` for the content but needs `twitter:card` to render the large form at all, and the two
      it is paired with here are what other consumers of the Twitter vocabulary expect beside it.

      Absolute URLs throughout, and not because the specification is fussy about it. A relative
      `og:image` is resolved by a crawler against nothing, so it fails on the machines that read it
      and works in every browser anyone would test it in.
    */}
    <meta property="og:site_name" content="Ohio school funding" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(WIDTH)} />
    <meta property="og:image:height" content={String(HEIGHT)} />
    <meta property="og:image:alt" content={imageAlt ?? description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={cardUrl} />

    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replaceAll("<", "\\u003c")}
        />
      )
    }
  </head>
  <body>
    {/*
      The first thing in the document, and the first thing a keyboard reaches.

      There was none. Every page opens with a header carrying a brand link and five section
      disclosures, so a reader moving by keyboard passed six controls before the content on every
      page of the site, and a reader using a screen reader heard the whole bar again on each. It is
      the oldest affordance on the web and this site did not have it.

      Visible only on focus, which is what makes it free for everyone else — see `.skip` in
      `app.css`, where it is also placed clear of the sticky header it would otherwise land under.
    */}
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="site-inner">
        {/*
          The brand is the mark, and the mark is the file the browser tab is already showing.

          Inlined rather than fetched, which is the same call `.mark` makes in the footer and for the same
          two reasons — the content security policy admits no third-party origin, and a request per
          page buys nothing a cached path already has. It is NOT a second copy of the drawing:
          `inlineMark()` reads `public/favicon.svg`, the file `design/logo/outline.ts` emits and
          `//:generated` holds current, so the header and the tab cannot come to disagree.

          Its accessible name is the `aria-label` the SVG carries — the same four words the link
          used to spell out — so a screen reader hears no change. The focus ring is the browser's:
          `a:focus-visible` thickens an underline and leaves the outline alone, so a link with no
          word still keeps a ring around its box.
        */}
        <a class="brand" href="/"><Fragment set:html={inlineMark()} /></a>
        <nav aria-label="Sections">
          {/*
            One outer disclosure holding the six, rather than six in a row.

            At 390px the header wrapped to three rows and measured 166px, with the `h1` beginning
            at y=194 — a quarter of a phone screen spent before the reader learns which district
            they are looking at. The three flex children are the brand at 142px, this nav at 404px
            and the theme button at 32px, against about 352px of usable width, so no arrangement of
            them fits on one row. Only collapsing the nav does.

            It is ONE set of links, not a narrow copy and a wide copy. The wide layout is this same
            element with its outer summary hidden and its content forced visible — see
            `.menu-all` in `app.css`. A second copy would have meant 4,103 bytes of duplicate nav
            on every one of 3,492 pages, and 31 links in the document twice.
          */}
          <details class="menu-all">
            <summary aria-label="Sections menu">Menu</summary>
            <div class="menu-groups">
          {
            NAV.map((group, i) => group.kind === "place" ? (
              /*
                A flat entry: a link, one click from anywhere. `page` when this is the page, `true`
                when the page sits under it — a district page is not `/districts` and still
                belongs to it, and saying `page` there would tell a screen reader otherwise.
              */
              <a
                class="menu-place"
                href={group.front}
                aria-current={
                  group.front === here ? "page" : group.key === section ? "true" : undefined
                }
              >
                {group.label}
              </a>
            ) : (
              <details class="menu">
                {/* `true` rather than `page`: the group contains the current page, it is not the
                    current page. The distinction is what a screen reader reads out. A group is
                    also current when the page names the group itself, which is how every corpus
                    node marks `Library` while the menu names only their classes. */}
                <summary
                  aria-current={
                    group.key === section ||
                    groupLinks(group).some((link) => isCurrent(link))
                      ? "true"
                      : undefined
                  }
                >
                  {group.label}
                </summary>
                {/* A wide panel in the bar's right half hangs from its right edge, or it would run
                    off the window; one in the left half hangs from its left, or it would run off
                    the other side. `Library` is the first, `Explained` the second (#718). */}
                <div
                  class="menu-panel"
                  data-width={group.wide ? "wide" : undefined}
                  data-hang={group.wide && i >= NAV.length / 2 ? "right" : undefined}
                >
                  {/* The lead: `Library`'s record, as tiles across the panel — see `NavGroup.lead`.
                      The glyph is `aria-hidden`; the label is still the link's whole name. */}
                  {group.lead ? (
                    <div class="menu-lead">
                      {group.lead.map((link) => (
                        <a href={link.href} aria-current={isCurrent(link) ? "page" : undefined}>
                          {link.icon ? (
                            <svg
                              class="menu-icon"
                              viewBox={ICON_VIEWBOX}
                              width="20"
                              height="20"
                              aria-hidden="true"
                              focusable="false"
                            >
                              {ICONS[link.icon].map((d) => <path d={d} />)}
                            </svg>
                          ) : null}
                          <span class="menu-text">
                            <span class="menu-label">{link.label}</span>
                            {link.note ? <span class="menu-note">{link.note}</span> : null}
                          </span>
                        </a>
                      ))}
                    </div>
                  ) : null}
                  {/* One box around the runs, so a `wide` panel can set them in columns below its
                      lead. Elsewhere `display: contents`, and the runs are the panel's own. */}
                  <div class="menu-runs">
                    {group.sections.map((run) => (
                      <div class="menu-run">
                        {/* Text, not a heading element: the bar is on every page, and an `h3` in
                            it would be the first heading of each one's outline. */}
                        {run.heading ? <span class="menu-heading">{run.heading}</span> : null}
                        {run.links.map((link) => (
                          <a href={link.href} aria-current={isCurrent(link) ? "page" : undefined}>
                            <span class="menu-label">{link.label}</span>
                            {link.note ? <span class="menu-note">{link.note}</span> : null}
                          </a>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              </details>
            ))
          }
            </div>
          </details>
        </nav>
        {/*
          Named for the thing it toggles rather than for the act of toggling, because it carries
          an `aria-pressed` state now and "Switch colour theme, pressed" is not a sentence. The
          state itself is set by `site.ts`: which theme is in force depends on a stored choice and
          on the operating system, and the build knows neither.
        */}
        <button id="theme" type="button" class="pill" aria-label="Dark theme" aria-pressed="false"
          >◐</button
        >
      </div>
    </header>

    <main id="main" class="wrap" data-width={wide ? "wide" : undefined}>
      <Fragment set:html={body} />
    </main>

    <footer class="site">
      <div class="wrap" data-width={wide ? "wide" : undefined}>
        {/*
          Plain language, because this line is on every page and is read by people who arrived from
          a shared link, not from the repository. It used to name the crate that computes the
          reference forecasts, print the provenance paragraph with a `.yidam/catalog/` pointer and
          state the bundle contract version. Those are for a technical reader, who looks for them
          on /method and /data, and both pages still carry them (#571).
        */}
        <p>
          {
            forecastable
              ? `Every figure is checked against ${checkpoints} reference scenarios and ${forecasts} reference forecasts before the site is built.`
              : `Every figure is checked against ${checkpoints} reference scenarios before the site is built. The projection check did not pass, so no band is drawn.`
          }{" "}
          FY{bundle.fiscal_year} model.
        </p>
        <p>
          Data: the Ohio Department of Education and Workforce's{" "}
          <a href={model.href}>FY{bundle.fiscal_year} funding calculator</a>, dated{" "}
          <time datetime={model.iso}>{model.date}</time>. Maintained by {maintainer} ·{" "}
          <a href={reportError(canonical.pathname)} rel="noopener noreferrer" target="_blank"
            >Report an error</a
          >
        </p>
        <p class="screen-links">
          <a href="/method">How these figures are made</a> · <a href="/data">Download the data</a>
        </p>
        {/*
          The repository, which with the report link above is the only external link in the
          site's chrome.

          Every figure on every page is computed by code in it, and a reader who wants to check
          one needs somewhere to go. It sat in the header beside the theme button until
          #548, which moved it here: the bar is for moving around this site, and a link that leaves
          it spent header width the six entries needed — at 360px it was already hidden to make
          room. The footer has room at every width, so it is shown at every width.

          Inline rather than fetched: the content security policy admits no third-party origin, and
          one 16px path is cheaper than a request would be even if it did.
        */}
        <p class="screen-links">
          <a
            class="mark"
            href={REPOSITORY}
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path>
            </svg>
            <span>Source on GitHub</span>
          </a>
        </p>
        {/*
          Paper only: the address this page was printed from (#602). A printed district page is
          carried to a meeting and read away from the screen, and without it nothing on the sheet
          leads back to the page — the browser's own header line is a print-dialog option a reader
          may have turned off.
        */}
        <p class="print-url">{canonical.href}</p>
      </div>
    </footer>

    <div id="tip" hidden></div>
    {/*
      What the keyboard cursor is on, for a reader who cannot see the tooltip.

      Separate from `#tip` rather than announcing that, because the tooltip is rewritten on every
      mouse move and a live region tracking those would be unusable. Written only by the arrow
      keys — see `attachValues` in `src/lib/chart.ts`.
    */}
    <div id="said" class="vh" aria-live="polite" aria-atomic="true"></div>
    {/*
      That the result was rebuilt, for the three routes that rebuild theirs.

      A second region rather than sharing the one above, because the two have different owners and
      different rhythms: `#said` is written by an arrow key and cleared when the reader leaves the
      chart, and this is written once the levers stop moving. One region owned by two callers is
      one that clears the other's sentence half-read. See `src/lib/status.ts`.
    */}
    <div id="changed" class="vh" aria-live="polite" aria-atomic="true"></div>
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
