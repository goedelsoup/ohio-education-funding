---
/**
 * The shell every page wears.
 *
 * Unlike the document this replaced, it is not inert. The figures are written into the HTML at
 * build time by `getStaticPaths` and the renderers in `src/lib/`, so a page is complete before
 * any JavaScript runs and stays complete if none ever does. `src/scripts/site.ts` adds the
 * hover layer, the theme switch, and the nominal/constant-dollar toggle on top of a page that
 * already reads correctly without them.
 */
import { loadFeed } from "../lib/feed.ts";
import { canonicalPath, og } from "../lib/routes.ts";
import { HEIGHT, WIDTH } from "../lib/og/card.ts";
import "../styles/app.css";

interface Props {
  /** The `<title>`, before the site name is appended. */
  title: string;
  /** One sentence. Used for `<meta name="description">` and for the preview card's caption. */
  description: string;
  /**
   * The preview card for this page, from the `og` table in `src/lib/routes.ts`.
   *
   * Omitting it is not an error — the page previews as the site. That is the right default for
   * `/search` and `/404`, which are not about anything, and it means a route added later gets a
   * usable preview rather than none while nobody notices.
   */
  image?: string;
  /** What the card shows, for a reader who cannot see it. Falls back to the description. */
  imageAlt?: string;
  /** Which top-level nav entry is the current section, if any. */
  section?:
    | "statewide"
    | "districts"
    | "counties"
    | "house"
    | "senate"
    | "compare"
    | "outcomes"
    | "history"
    | "scenario"
    | "wiki"
    | "method"
    | "data";
  /** Rendered above the page, before the slot. Used for the district sub-navigation. */
  wide?: boolean;
}

const {
  title,
  description,
  section,
  wide = false,
  image = og.default(),
  imageAlt,
} = Astro.props;
const { bundle, verification, forecastable } = loadFeed();

/**
 * This page's address, as a reader would type it.
 *
 * `Astro.url.pathname` reports the *file* being written — `build.format` is `"file"`, so that is
 * `/district/043786.html` — and both the canonical link and `og:url` have to name a URL that
 * resolves. They are computed from one value here so they cannot disagree, which they previously
 * could not have done only because there was one of them.
 */
const site = Astro.site ?? new URL("https://schools.ohio.shawneesmart.systems");
const canonical = new URL(canonicalPath(Astro.url.pathname), site);
const cardUrl = new URL(image, site);
/** `og:title` is read without the tab strip around it, so it carries the site name too. */
const socialTitle = `${title} — Ohio school funding`;

/**
 * The sections, two of them flat and three of them grouped.
 *
 * # Why anything is grouped
 *
 * Ten entries wrapped to a second row on a laptop and read as a list rather than as a structure.
 * Grouping is not only decluttering, though: `/compare` and `/data` are real pages that were
 * reachable from the footer or from nothing, because a flat bar had no room to admit them.
 *
 * # Why `<details>` and not a menu
 *
 * A third of the end-to-end suite runs with JavaScript disabled, and this repository has already
 * decided once that a control which dies without script is worse than no control — see
 * `BasisToggle.astro`. A native disclosure needs nothing running: it opens on click, on Enter and
 * on Space, and screen readers announce its state without being told to.
 *
 * The cost is that two menus can sit open at once, because closing a sibling needs a script.
 * `site.ts` closes them when one opens, and on Escape and on a click outside — and a reader
 * without it gets two open menus rather than a menu that does not open.
 */
const NAV = [
  { key: "statewide", href: "/", label: "Statewide" },
  {
    label: "Places",
    children: [
      // Read from the feed, not typed in, for the reason `og/pages.ts` gives at length: a count
      // that a regenerated panel makes wrong is worse than no count. This one is on every page.
      { key: "districts", href: "/districts", label: `All ${bundle.statewide.districts} districts` },
      { key: "counties", href: "/counties", label: "Counties" },
      { key: "house", href: "/house", label: "House" },
      { key: "senate", href: "/senate", label: "Senate" },
      { key: "compare", href: "/compare", label: "Compare two" },
    ],
  },
  {
    label: "Findings",
    children: [
      { key: "outcomes", href: "/outcomes", label: "Outcomes" },
      { key: "history", href: "/history", label: "History" },
    ],
  },
  { key: "scenario", href: "/scenario", label: "Scenario" },
  {
    label: "Reference",
    children: [
      { key: "wiki", href: "/wiki", label: "Wiki" },
      { key: "method", href: "/method", label: "Method" },
      { key: "data", href: "/data", label: "Downloads" },
    ],
  },
] as const;

const checkpoints = verification.comparisons.length;
const forecasts = verification.forecasts.length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Ohio school funding</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* The mark. SVG for browsers, 32px PNG for the unfurlers that will not take one, 180px for
        iOS. All three are the same drawing — see `src/lib/og/mark.ts`. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/*
      What a link to this page looks like when it is pasted somewhere.

      Open Graph is read by Slack, Discord, Facebook, LinkedIn, Bluesky and — since it stopped
      reading its own — X. The three `twitter:` tags below are not redundant with it: X takes
      `og:*` for the content but needs `twitter:card` to render the large form at all, and the two
      it is paired with here are what other consumers of the Twitter vocabulary expect beside it.

      Absolute URLs throughout, and not because the specification is fussy about it. A relative
      `og:image` is resolved by a crawler against nothing, so it fails on the machines that read it
      and works in every browser anyone would test it in.
    */}
    <meta property="og:site_name" content="Ohio school funding" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(WIDTH)} />
    <meta property="og:image:height" content={String(HEIGHT)} />
    <meta property="og:image:alt" content={imageAlt ?? description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={cardUrl} />
  </head>
  <body>
    <header class="site">
      <div class="site-inner">
        <a class="brand" href="/">Ohio school funding</a>
        <nav aria-label="Sections">
          {
            NAV.map((entry) =>
              "children" in entry ? (
                <details class="menu">
                  {/* `true` rather than `page`: the group contains the current page, it is not
                      the current page. The distinction is what a screen reader reads out. */}
                  <summary
                    aria-current={
                      entry.children.some((child) => child.key === section) ? "true" : undefined
                    }
                  >
                    {entry.label}
                  </summary>
                  <div class="menu-panel">
                    {entry.children.map((child) => (
                      <a
                        href={child.href}
                        aria-current={child.key === section ? "page" : undefined}
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </details>
              ) : (
                <a href={entry.href} aria-current={entry.key === section ? "page" : undefined}>
                  {entry.label}
                </a>
              ),
            )
          }
        </nav>
        <form class="site-search" action="/search" method="get" role="search">
          <label class="vh" for="q">Search districts and the corpus</label>
          <input id="q" name="q" type="search" placeholder="District or concept…" autocomplete="off" />
        </form>
        <button id="theme" type="button" class="ghost" aria-label="Switch colour theme">◐</button>
      </div>
    </header>

    <main class={wide ? "wrap wide" : "wrap"}>
      <slot />
    </main>

    <footer class="site">
      <div class={wide ? "wrap wide" : "wrap"}>
        <p>
          {
            forecastable
              ? `Formula verified at build against ${checkpoints} reference scenarios and ${forecasts} reference forecasts computed by crates/project.`
              : `Formula verified at build against ${checkpoints} reference scenarios. The projection check did not pass, so no band is drawn.`
          }{" "}
          <a href="/method">How these figures are made</a> · <a href="/data">Download the data</a>
        </p>
        <p>{bundle.provenance}</p>
        <p>Bundle contract {bundle.contract_version}. FY{bundle.fiscal_year} model.</p>
      </div>
    </footer>

    <div id="tip" hidden></div>
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
