---
/**
 * One measure's statewide distribution, with this district marked on it.
 *
 * The distribution, not a flat bar with a pin in it.
 *
 * The bar this replaced drew the minimum at one end, the maximum at the other, and nothing in
 * between — so a district at the 60th percentile and one at the 95th looked equally at home,
 * when the first is in a dense middle and the second is nearly alone. These measures are the
 * ones where that matters most: assessed valuation per pupil runs to five and a half times the
 * median, and the top of the range is one district.
 *
 * The percentile stays underneath. It is the sentence a reader repeats and the box is what makes
 * it mean something.
 */
import { count, money, ordinal, percentileOf } from "../../lib/format.ts";
import { distributionSpec, type Drawing, nearestRank } from "../../lib/plot/spec.ts";
import { renderToString } from "../../lib/plot/ssr.ts";
import type { District } from "../../lib/types.ts";

interface Props {
  label: string;
  /** This district's value, or null where it reported none. */
  value: number | null;
  /** Every reporting district's value, ascending. */
  sorted: number[];
  population: District[];
  measure: (d: District) => number | null | undefined;
  /** Where the label links, which is the corpus node defining the measure. */
  href?: string;
}

const { label, value, sorted, population, measure, href } = Astro.props;
const percentile = value == null ? null : ordinal(Math.round(percentileOf(sorted, value) * 100));

const box: Drawing | null =
  value == null
    ? null
    : (w) =>
        distributionSpec(
          population
            .map((d) => ({ d, v: measure(d) }))
            .filter((row): row is { d: District; v: number } => row.v != null)
            .map(({ d, v }) => ({ value: v, hover: `${d.name}: ${money(v)}` })),
          { width: w, marker: { value, label } },
        );
---

{
  box == null ? (
    <p class="note">{href ? <a href={href}>{label}</a> : label}: not reported.</p>
  ) : (
    <div class="strip-row">
      <div class="strip-head">
        <span>{href ? <a href={href}>{label}</a> : label}</span>{" "}
        <strong class="tnum">{money(value)}{" "}
          <span class="n">{percentile} percentile</span></strong>
      </div>
      <div class="chart-scale">
        <div class="chartwrap" data-chart="position" set:html={renderToString(box, { label: `${label} across the ${count(sorted.length)} districts reporting it, with this district at ${money(value)}, the ${percentile} percentile`, description: `Quartiles run ${money(nearestRank(sorted, 0.25))} to ${money(nearestRank(sorted, 0.75))}, median ${money(nearestRank(sorted, 0.5))}` })} />
        <div class="scale">
          <span>{money(sorted[0] ?? 0)}</span>{" "}
          <span>{money(sorted[sorted.length - 1] ?? 0)}</span>
        </div>
      </div>
    </div>
  )
}
