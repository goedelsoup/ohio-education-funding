---
/**
 * The levers.
 *
 * Server-rendered, unlike everything else on the scenario routes. The controls are the one part
 * of those pages that does not depend on the browser having reproduced the Rust checkpoints yet,
 * and putting them in the document means the page has visible structure before the panel has
 * finished downloading rather than a blank rectangle.
 *
 * They are real form controls inside a real `<form>`, so a reader can tab through them and a
 * screen reader announces them, and their values are read on every `input` event by
 * `src/scripts/scenario.ts`. With no script they render and do nothing — which is why the page
 * around them says so rather than pretending otherwise.
 */
import { DEFAULT_HORIZON_YEARS, LEVER_BOUNDS } from "../lib/scenario.ts";
import type { RefreshEffect } from "../lib/refresh.ts";
import { pct } from "../lib/format.ts";
import { yearOf } from "../lib/year.ts";
import SectionAnchor from "./SectionAnchor.astro";

interface Props {
  /** The minimum state share the published model was computed under. */
  model: number;
  /** How many districts the guarantee currently holds above the formula. */
  onGuarantee: number;
  /** The last observed fiscal year, and the furthest the feed's checkpoints reach. */
  projection: { available: boolean; baseYear: number; maxYear: number };
  /**
   * The refresh the feed prices, for the base cost lever's note. `null` where it prices none.
   *
   * This note read "roughly +3%" while both drafts that price a refresh set `1.0395`, and the
   * held-fixed card said 3.1% for a third refresh the model has already absorbed. Three numbers for
   * one quantity, and none of them said which refresh it was.
   */
  refresh: RefreshEffect | null;
}

const { model, onGuarantee, projection, refresh } = Astro.props;

/*
 * The five sliders. Their ends come from `LEVER_BOUNDS` rather than being written here.
 *
 * They used to be written here, and that made this file the only validator: `readLevers` reads
 * `input.value`, which a browser has already clamped against these attributes. The `?draft=` path
 * renders before the first read of a control, so a query string reaching it was never held to
 * anything — see `clampLevers`. One declaration, two consumers.
 */
const SLIDERS = [
  {
    id: "lv-arg",
    label: "Guarantee retained",
    ...LEVER_BOUNDS.guaranteeArgument,
    value: 0.5,
    note: "Applies to phase-out and re-base.",
  },
  {
    id: "lv-base",
    label: "Base cost",
    ...LEVER_BOUNDS.baseCostScale,
    value: 1,
    note: refresh
      ? `A refresh of the FY2022 cost inputs is +${pct(refresh.scale - 1, 2)} — the restatement ${refresh.slug} prices.`
      : "A refresh restates the cost inputs at a later year's prices.",
  },
  {
    id: "lv-min",
    label: "Minimum state share",
    ...LEVER_BOUNDS.minimumStateShare,
    value: model,
    /* The one lever note whose figure is read from the model rather than being a fact about the
       past. The other four name their own years already — FY2022 cost inputs, the FY2020 base,
       DPIA's FY2019 — and this one said "current" for a model that is current until it is not. */
    note: `Current model, ${yearOf("formula")}: ${pct(model, 0)}. The plan was enacted with 5%.`,
  },
  {
    id: "lv-phase",
    label: "Phase-in, general",
    ...LEVER_BOUNDS.phaseInGeneral,
    value: 1,
    note: "How far from the FY2020 funding base toward the computed amount. At 0% a district receives its FY2020 base, not nothing.",
  },
  {
    id: "lv-phase-dpia",
    label: "Phase-in, DPIA",
    ...LEVER_BOUNDS.phaseInDpia,
    value: 1,
    note: "Separate because R.C. 3317.022 writes two terms: in FY2022 the general percentage was 16.67% while DPIA's was 0%, which paid DPIA at its whole FY2019 amount.",
  },
];
---

<div class="card" id="levers" data-part="levers">
  <h2><SectionAnchor id="levers" />Levers</h2>
  <form id="scenario-controls">
    <div class="levers">
      <div class="lever">
        <label for="lv-guarantee">Temporary transitional aid guarantee</label>
        <select id="lv-guarantee">
          <option value="as-enacted">As enacted — hold at FY2020</option>
          <option value="phase-out">Phase out</option>
          <option value="rebase">Re-base the FY2020 floor</option>
          <option value="removed">Remove entirely</option>
        </select>
        <div class="n">{onGuarantee} districts are held above what the formula computes for them.</div>
      </div>
      {
        SLIDERS.map((slider) => (
          <div class="lever">
            <label for={slider.id}>
              {slider.label} <output id={`${slider.id}-out`} />
            </label>
            <input
              type="range"
              id={slider.id}
              min={slider.min}
              max={slider.max}
              step={slider.step}
              value={slider.value}
            />
            <div class="n">{slider.note}</div>
          </div>
        ))
      }
      {
        /*
         * The horizon control appears only when a band could be drawn. Offering a year picker
         * that produces nothing would be worse than not offering one.
         */
        projection.available && (
          <div class="lever">
            <label for="lv-horizon">
              Project enrollment to <output id="lv-horizon-out" />
            </label>
            <input
              type="range"
              id="lv-horizon"
              min={projection.baseYear}
              max={projection.maxYear}
              step={1}
              value={projection.baseYear + DEFAULT_HORIZON_YEARS}
            />
            <div class="n">
              FY{projection.baseYear} is the last observed year — leave it there for no forecast.
            </div>
          </div>
        )
      }
    </div>
    <p class="note">
      <button id="scenario-reset" type="button" class="flag">Reset to current law</button>
    </p>
  </form>
</div>
