---
/**
 * The runner's two views, as tabs.
 *
 * `Change the formula` is one place with two questions — *what changes* and *who it reaches* — and these
 * are the way between them. The same `.subnav` a district's five views use, because the
 * relationship is the same: each tab is a document that exists on its own, and the tabs say which
 * one this is.
 *
 * `data-carry-levers` is what makes them one place rather than two pages that happen to share a
 * heading. The runner rewrites each tab's query to the reader's current levers on every tick, so
 * crossing to the other question keeps the scenario being asked about. With no script the tabs are
 * plain links and carry nothing, which is correct: with no script nothing has moved.
 */
import { RUNNER_VIEWS, type RunnerView } from "../lib/nav.ts";

interface Props {
  current: RunnerView;
}

const { current } = Astro.props;
---

<nav class="subnav" aria-label="Views of this runner">
  {
    RUNNER_VIEWS.map((view) => (
      <a
        href={view.href}
        data-carry-levers
        aria-current={view.key === current ? "page" : undefined}
      >
        {view.label}
      </a>
    ))
  }
</nav>
