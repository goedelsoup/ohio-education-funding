---
/**
 * Not found — which, on a site keyed by six-digit IRN and three-digit seat number, is mostly a
 * typo.
 *
 * It says so and offers the two ways out: the name-or-IRN field, which is where a mistyped IRN is
 * actually recoverable, and every section of the site. This page used to guess instead, offering
 * the districts whose IRN was closest — but a six-digit key has no meaningful neighbourhood, so any
 * path with three digits in it drew six unrelated districts and dressed them as answers. A wrong
 * guess that looks like a working link is worse than a dead end that names the way out.
 *
 * An IRN or seat typed without its leading zeros never reaches this page: the host redirects it
 * (`withUnpadded` in `src/lib/redirects.ts`, #596).
 *
 * The sections are read from `nav()`, as the homepage's are, and listed rather than tabled: a
 * two-column table of them was 392px wide in a 295px card at 375.
 */
import Base from "../layouts/Base.astro";
import FindDistrict from "../components/FindDistrict.astro";
import SectionAnchor from "../components/SectionAnchor.astro";
import { loadFeed } from "../lib/feed.ts";
import { count } from "../lib/format.ts";
import { nav } from "../lib/nav.ts";

const { bundle } = loadFeed();
const s = bundle.statewide;
---

<Base
  title="Not found"
  description="No page at that address. Districts are keyed by six-digit IRN; find one by name or IRN."
>
  <h1>No page at that address</h1>
  <p class="lead">
    This site has a page for each of Ohio's {count(s.districts)} school districts, keyed by the
    six-digit IRN, and for each county and each House and Senate seat. If you typed an IRN, one
    digit is the usual cause.
  </p>

  <div class="card" id="find-a-district" data-part="find-a-district">
    <h2><SectionAnchor id="find-a-district" />Find a district</h2>
    <FindDistrict id="missing-q" />
  </div>

  <div class="card" id="where-to-go" data-part="where-to-go">
    <h2><SectionAnchor id="where-to-go" />Every section of the site</h2>
    <ul>
      {
        nav(bundle).map((entry) => (
          <li>
            <a href={entry.front}>{entry.label}</a>: {entry.blurb}
          </li>
        ))
      }
    </ul>
  </div>
</Base>
