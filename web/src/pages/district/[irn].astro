---
/**
 * One district's dashboard: what the Fair School Funding Plan computes for it, what it actually
 * receives, and where the difference comes from.
 *
 * Every figure on this page is written at build time. The page carries no feed and fetches
 * nothing; `getStaticPaths` handed it one district out of 609 and the renderers in
 * `src/lib/district.ts` turned that into markup. It is complete before any script runs.
 */
import DistrictNav from "../../components/DistrictNav.astro";
import Base from "../../layouts/Base.astro";
import { renderBaseCostBuildUp } from "../../lib/basecost.ts";
import {
  renderAidSource,
  renderEnrollmentYears,
  renderCategoricals,
  renderPosition,
  renderNationalPosition,
  renderSupplements,
  renderWhatThisIsNot,
} from "../../lib/district.ts";
import { slugify } from "../../lib/county.ts";
import { districtPaths, loadFeed, qualifiedName } from "../../lib/feed.ts";
import * as routes from "../../lib/routes.ts";
import { money, pct } from "../../lib/format.ts";

export const getStaticPaths = districtPaths;

const { district } = Astro.props;
const { bundle, forecastable, valuations, expenditures } = loadFeed();

/*
 * The Senate seats this district lies in, derived from the seat rosters rather than carried
 * per district. The feed already lists every seat's members, so a second per-district array would
 * be the same information twice — and the House one only exists because the scenario builder's
 * type excludes it and something had to be excluded.
 */
const senateSeats = bundle.senate_districts
  .filter((seat) => seat.members.some((m) => m.irn === district.irn))
  .map((seat) => seat.number)
  .sort();

const guaranteePP = district.realized_aid_per_pupil - district.formula_aid_per_pupil;
const description = district.on_guarantee
  ? `${district.name} receives ${money(district.realized_aid_per_pupil)} per pupil in state aid, of which ${money(guaranteePP)} comes from the temporary transitional aid guarantee rather than the formula.`
  : `${district.name} receives ${money(district.realized_aid_per_pupil)} per pupil in state aid, all of it computed by the formula.`;
---

<Base
  title={qualifiedName(district)}
  description={description}
  image={routes.og.district(district.irn)}
  imageAlt={`${district.name}: state aid per pupil, and how much of it comes from the guarantee`}
  section="districts"
>
  <h1>{qualifiedName(district)}</h1>
  {/*
     The identity line, as a labelled set rather than a middot-joined sentence.

     What it was: IRN, county, every Senate seat, every House seat, the model's district count,
     the funding status, the millage position and the disadvantage share, all joined by `·`. On
     the two districts that span the most seats — Columbus at 16 links, Cleveland at 14 — that is
     a wall of underlined text before the reader reaches anything they can read.

     It is a tail: measured across all 609 district pages the mean is 4.2 links and 572 of them
     carry between three and six, so this is not the emergency the issue's "twenty" suggested. It
     is still worth doing, because a label tells a reader what a number IS — `18, 21, 23, 24` is
     meaningless without the word Senate in front of it, and in a run of middots that word is
     doing double duty as both a label and a separator.

     A `<dl>` because these are name/value pairs and that is what a description list is for. The
     `<div>` wrappers are the grouping HTML5 allows inside one, and they are what lets each pair
     stay together when the row wraps.

     One hazard disappears with the middots. `check-dist-links.ts` scans every built page for a
     `·` fused to an element boundary, because Astro trims a newline against an expression and
     609 pages once shipped reading `Cuyahoga County· Senate 18` — 1,827 of them in the build.
     That scan stays; this page simply stops being able to fail it.
  */}
  <dl class="facts" data-part="identity">
    <div><dt>IRN</dt><dd>{district.irn}</dd></div>
    <div>
      <dt>County</dt>
      <dd><a href={routes.county(slugify(district.county))}>{district.county}</a></dd>
    </div>
    {/* Every seat this district lies in, linked individually rather than counted: the reverse
        question — who represents these schools — is the one a reader arriving from a legislative
        page is asking, and 28 of Ohio's districts share a name so the seat number is often the
        clearer handle. */}
    <div>
      <dt>Senate</dt>
      <dd>
        {senateSeats.map((n, i) => (
          <Fragment>
            {i > 0 ? ", " : ""}<a href={routes.senateDistrict(n)}>{Number(n)}</a>
          </Fragment>
        ))}
      </dd>
    </div>
    <div>
      <dt>House</dt>
      <dd>
        {district.house_districts.map((h, i) => (
          <Fragment>
            {i > 0 ? ", " : ""}<a href={routes.houseDistrict(h.number)}>{Number(h.number)}</a>
          </Fragment>
        ))}
      </dd>
    </div>
    <div>
      <dt>Funding</dt>
      <dd>{district.on_guarantee ? "on the guarantee" : "on formula"}</dd>
    </div>
    {district.at_millage_floor && (
      <div>
        <dt>Millage</dt>
        <dd>{(district.millage?.observed_rate ?? 20) < 19.995 ? "below 20 mills" : "at the 20-mill floor"}</dd>
      </div>
    )}
    {district.economically_disadvantaged != null && (
      <div>
        <dt>Disadvantaged</dt>
        <dd>{pct(district.economically_disadvantaged, 1)}</dd>
      </div>
    )}
    {/* Not a fact about this district, and labelled so it does not read as one: it says what the
        district is being counted among, which is the thing every figure below is relative to. */}
    <div>
      <dt>In the model</dt>
      <dd>{bundle.statewide.districts} districts, FY{bundle.fiscal_year}</dd>
    </div>
  </dl>

  <DistrictNav irn={district.irn} current="dashboard" />

  {/* The answer first. This card opened with base cost per pupil, which is an input to the
      formula rather than money anyone receives, while the page's own description, its share image
      and this card's heading all said the question was state aid. */}
  <Fragment set:html={renderAidSource(bundle, district)} />
  {/* Third clause of that question, answered directly: for the 294 guaranteed districts this
      card says a year of enrollment is worth nothing to them. It was in position six. */}
  <Fragment set:html={renderEnrollmentYears(bundle, district, forecastable)} />
  <Fragment set:html={renderBaseCostBuildUp(district, bundle.statewide.districts)} />
  {/* The other half of formula aid, decomposed the same way and for the same reason. */}
  <Fragment set:html={renderCategoricals(district, bundle.statewide)} />
  {/* Everything above is foundation funding, which the guarantee holds. This is not. */}
  <Fragment set:html={renderSupplements(district, bundle.statewide)} />
  <Fragment set:html={renderPosition(bundle, district, valuations, expenditures)} />
  {/* Ohio describing itself cannot say whether Ohio is unusual. This is the one card that can. */}
  <Fragment set:html={renderNationalPosition(district)} />
  {/* Three of the four siblings close by declaring what they are not. This route has the most
      collisions to declare and was the last to say so. */}
  <Fragment set:html={renderWhatThisIsNot(bundle, district)} />
</Base>
