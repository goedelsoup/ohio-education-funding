---
/**
 * The local half of the formula, for one district.
 *
 * Local capacity is 60% assessed valuation and sets the state's residual share, so property is
 * most of what decides a district's funding — and the site represented all of it with a single
 * number. This is Table SD-1, from the Department of Taxation rather than the Department of
 * Education: two tax years, the base broken into the classes that are reduced separately, and
 * what H.B. 920 did to the rate in between.
 */
import DistrictNav from "../../../components/DistrictNav.astro";
import Base from "../../../layouts/Base.astro";
import { districtPaths, loadFeed, qualifiedName } from "../../../lib/feed.ts";
import { count, fig, money, pct } from "../../../lib/format.ts";
import * as routes from "../../../lib/routes.ts";
import {
  renderChargeOff,
  renderDenominators,
  renderMillage,
  renderTaxAgainstSpending,
  renderTaxBase,
  renderTaxChange,
} from "../../../lib/tax.ts";
import SectionAnchor from "../../../components/SectionAnchor.astro";

export const getStaticPaths = districtPaths;

const { district } = Astro.props;
const { bundle, tax } = loadFeed();
const latest = district.property_tax[district.property_tax.length - 1];

/*
 * The two tax years this card contrasts, derived rather than typed.
 *
 * They were the literals `TY2023` and `TY2024`, beside a hard-coded count of `219`. Correct when
 * written, and correct only until either publisher advances — the profile report's column is a
 * year behind Taxation's latest **by construction**, so the pair moves together and nothing in the
 * copy would have said so. This is the shape of the defect
 * `.yidam/decisions/every-figure-says-its-year.yml` was written about: a claim in prose beside a
 * claim in data, unable to disagree in a way anything notices.
 */
const latestTaxYear = latest ? `TY${latest.tax_year}` : "";
const profileTaxYear = latest ? `TY${latest.tax_year - 1}` : "";

const description = latest
  ? `${district.name} has ${money(latest.total_value)} of taxable property, ${money(latest.value_per_pupil)} per pupil, charged at ${latest.class1_rate.toFixed(2)} effective Class I mills in TY${latest.tax_year}.`
  : `No Table SD-1 row is published for ${district.name}.`;
---

<Base
  title={`${qualifiedName(district)} — property tax`}
  description={description}
  image={routes.og.district(district.irn)}
  imageAlt={`${district.name}: state aid per pupil, and how much of it comes from the guarantee`}
  section="districts"
>
  <h1>{qualifiedName(district)}</h1>
  <p class="sub">
    What property here is worth, what is charged on it, and which side of the 20-mill floor the
    district is on — which decides whether a reappraisal reaches its revenue at all.
  </p>

  <DistrictNav irn={district.irn} current="taxes" />

  {
    !latest ? (
      <div class="card" id="not-published" data-part="not-published">
        <h2><SectionAnchor id="not-published" />Not in Table SD-1</h2>
        <p class="note">
          No row is published for this district in the Department of Taxation's per-district table,
          so its tax base cannot be shown here. Its funding model is on the{" "}
          <a href={routes.district(district.irn)}>dashboard</a>.
        </p>
      </div>
    ) : (
      <>
        <div class="tiles">
          <div class="tile">
            <div class="k">Taxable value per pupil</div>
            <div class="v" set:html={fig(money(latest.value_per_pupil), `TY${latest.tax_year}`)} />
            <div class="n">
              {/* SD-1's median, not the profile report's — the two divide by different pupil
                  counts and this tile used to compare across them. */}
              statewide median {money(bundle.statewide.median_sd1_value_per_pupil)}, on this
              table's pupil count
            </div>
          </div>
          <div class="tile">
            <div class="k">Effective Class I millage</div>
            <div class="v" set:html={fig(latest.class1_rate.toFixed(2), `TY${latest.tax_year}`)} />
            <div class="n">
              {
                /* Below, at, near, above — four positions, because twenty-one districts charge
                   less than twenty mills and calling them "at the floor" reads as a rate they
                   are held to rather than one they never reached. */
                latest.class1_rate < 19.995
                  ? "below 20 mills — reduction factors have never operated"
                  : district.at_millage_floor
                    ? "at the 20-mill floor — reduction factors have stopped"
                    : district.near_millage_floor
                      ? "above the floor by a fraction of a mill"
                      : "above the floor — reduction factors are operative"
              }
            </div>
          </div>
          <div class="tile">
            <div class="k">Real property tax charged</div>
            <div class="v" set:html={fig(money(latest.real_property_taxes_charged), `TY${latest.tax_year}`)} />
            <div class="n">TY{latest.tax_year}, current expenses</div>
          </div>
        </div>

        <Fragment set:html={renderTaxChange(district, tax)} />
        <Fragment set:html={renderMillage(district, bundle.statewide)} />
        <Fragment set:html={renderTaxBase(district)} />
        <Fragment set:html={renderTaxAgainstSpending(district, tax)} />
        {/* The denominator card first: the charge-off below it is computed on the funding
            formula's pupil count rather than this table's, and a reader meeting two different
            valuations per pupil needs the reason before the second one, not after. */}
        <Fragment set:html={renderDenominators(district)} />
        <Fragment set:html={renderChargeOff(district, bundle.statewide, tax)} />

        <div class="card" id="not" data-part="not">
          <h2><SectionAnchor id="not" />Where these figures come from, and what they are not</h2>
          <p class="note">
            Table SD-1, published by the <strong>Ohio Department of Taxation</strong> — a different
            department from the one that publishes the funding model every other page here reads.
            Where the two overlap they agree, <em>in the year they share</em>: this district's
            effective Class I rate for <strong>{profileTaxYear}</strong> matches the Department of
            Education's District Profile Report to 0.01 mills, and so does every one of the 606
            districts carrying both.
          </p>
          <p class="note">
            <strong>That is not the rate in the tile above.</strong> The tile is{" "}
            <strong>{latestTaxYear}</strong>, this table's latest year, and the profile report's
            column is <code>effective_class1_millage_ty{String(profileTaxYear).slice(-2)}</code> — a
            year behind by construction, as <code>crates/bundle</code> names it. The two
            publications agree on {latestTaxYear} for only{" "}
            <strong>{count(tax.agreeOnLatest)}</strong> of the 606, which is not a disagreement between departments but the ordinary fact that
            one of them has published a later year. The sentence above used to state the agreement
            without the year, three cards below a figure it was not about.
          </p>
          <p class="note">
            These are <strong>current expense</strong> levies only. Bond and permanent-improvement
            millage is excluded, and so are joint vocational operating levies, which are charged on
            the same property by a different taxing authority. The {
              pct(latest.public_utility_value / latest.total_value, 1)
            } of this district's {latestTaxYear} base that is public utility tangible property is neither Class I
            nor Class II and is not subject to reduction factors at all.
          </p>
          <p class="note">
            Nothing here is a projection. Valuation moves on a county reappraisal cycle rather than
            smoothly, which is why <a href="/scenario">the scenario builder</a> holds it fixed: the
            corpus has two observations per district and cannot forecast a step function.
          </p>
        </div>
      </>
    )
  }
</Base>
