---
/**
 * The same levers, answered for one district.
 *
 * This is the page a school board sends. It leads with what a proposed change does to them — and
 * then, in the same view and not behind a link, how many districts it moves the other way. A
 * scenario page that showed only the local number would let a reader conclude a change is good
 * because it is good for them, and the statewide count is the correction.
 *
 * Computed in the browser for the same reason `/scenario` is, and gated by the same reproduction
 * of the Rust checkpoints. It needs the whole panel even though it reports one district: the
 * checkpoints are statewide totals, and a gate that could not check them would not be a gate.
 */
import DistrictNav from "../../../components/DistrictNav.astro";
import HeldFixed from "../../../components/HeldFixed.astro";
import ScenarioControls from "../../../components/ScenarioControls.astro";
import Base from "../../../layouts/Base.astro";
import { districtPaths, loadFeed, qualifiedName } from "../../../lib/feed.ts";
import { money } from "../../../lib/format.ts";
import { refreshEffect } from "../../../lib/refresh.ts";
import { currentRealizedAid } from "../../../lib/policy.ts";
import * as routes from "../../../lib/routes.ts";
import { yearChip, yearOf } from "../../../lib/year.ts";
import SectionAnchor from "../../../components/SectionAnchor.astro";

export const getStaticPaths = districtPaths;

const { district } = Astro.props;
// No `forecastable` here on purpose: this view holds enrollment at the published year and never
// draws a band, so the projection gate has nothing to gate. The forecast lives on `/scenario`.
const { bundle } = loadFeed();
const s = bundle.statewide;
const meta = bundle.projection;
// The refresh the feed prices: named in the base cost lever's note and worked through in the
// held-fixed card, on both routes that render them.
const refresh = refreshEffect(bundle.districts, bundle.drafts, s.minimum_state_share);
---

<Base
  title={`${qualifiedName(district)} — scenario`}
  description={`What a change to the guarantee, base cost, minimum state share or phase-in would do to ${district.name}, and how many of Ohio's ${s.districts} districts it moves the other way.`}
  image={routes.og.district(district.irn)}
  imageAlt={`${district.name}: state aid per pupil, and how much of it comes from the guarantee`}
  section="districts"
>
  <h1>{qualifiedName(district)}</h1>
  <p class="sub">
    What a different decision would do here. Under current law this district receives {
      /*
       * Summed from the components rather than `realized_aid_per_pupil × current_year_adm`. The
       * per-pupil figure is published on base cost enrolled ADM — the greater of the three-year
       * average and the current year — so multiplying it by the current year's count is not a
       * rounding difference but a different quantity, and it disagreed with the tile below by
       * $193,000 before this was fixed.
       */
      money(currentRealizedAid(district))
    }{" "}
    in {yearOf("formula")}
    {district.on_guarantee ? ", and is held there by the guarantee." : ", and is funded by the formula."}
  </p>

  <DistrictNav irn={district.irn} current="scenario" />

  {/*
    The same caveat the statewide runner puts above its controls, above these for the same reason.

    This route had none of it. It renders the identical five levers, and the base cost one scales
    $812.5M of categoricals on top of base cost — a divergence from the department's own simulator
    that a reader of this page is entitled to know about before moving the slider, not after. That
    is more true here than on `/scenario`, not less: this is the page a school board sends.
  */}
  <HeldFixed districts={bundle.districts} total={s.districts} refresh={refresh} />

  <div id="scenario-root" data-irn={district.irn}>
    {/*
      The year chip, rendered here because the client cannot build one.

      `yearChip` reads the feed through `loadFeed`, which touches the filesystem, so the cards this
      route renders in the browser had no way to say what year their figures are on — and did not.
      Handing over the markup keeps one definition of the chip and puts it on cards a build-time
      pass can never reach. See `scripts/scenario.ts`.
    */}
    <template id="scenario-chip" set:html={yearChip("formula")} />

    <ScenarioControls
      model={s.minimum_state_share}
      onGuarantee={s.on_guarantee}
      projection={{ available: false, baseYear: meta?.base_year ?? 0, maxYear: meta?.horizon ?? 0 }}
      refresh={refresh}
    />

    <noscript>
      <div class="card err" id="needs-script" data-part="needs-script">
        <h2><SectionAnchor id="needs-script" />This is the one view that needs JavaScript</h2>
        <p class="note">
          The other three views of this district — its <a href={`/district/${district.irn}`}
            >dashboard</a
          >, <a href={`/district/${district.irn}/outcome`}>outcome</a> and <a
            href={`/district/${district.irn}/finances`}>finances</a
          > — carry every figure in the document and read correctly without any script. This one
          re-derives the funding formula as you move a slider.
        </p>
      </div>
    </noscript>

    <div id="scenario-out"></div>
    <p class="note" id="scenario-status"></p>
  </div>

  <div class="card" id="not" data-part="not">
    <h2><SectionAnchor id="not" />What this does not move</h2>
    <p class="note">
      Assessed valuation is held fixed, because the corpus has one observation per district and
      cannot project it. Local capacity is 60% valuation, so a scenario in which property values
      move is out of reach here. Enrollment is held at published FY{meta?.base_year ?? ""} — the
      enrollment forecast lives on <a href="/scenario">the statewide scenario</a>, where the band
      is the subject and is drawn as one.
    </p>
    <p class="note">
      This view holds enrollment fixed and moves the formula. The reciprocal — the formula held
      completely fixed and run at each published year's enrollment, with this district's own band
      carried forward — is <a href={routes.district(district.irn)}>on its dashboard</a>. The two
      were built a phase apart and neither said the other existed.
    </p>
  </div>

  <script>
    import "../../../scripts/scenario.ts";
  </script>
</Base>
