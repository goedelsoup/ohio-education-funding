---
/**
 * What districts achieve, and how little of it the funding side explains.
 *
 * The axis the corpus spent three phases building. Its job is not to display the Performance
 * Index — it is to make two specific misreadings hard, and the renderer it delegates to enforces
 * that by never emitting an association without its controlled figure beside it.
 */
import Base from "../layouts/Base.astro";
import { NAMES } from "../lib/nav.ts";
import { loadFeed } from "../lib/feed.ts";
import { fixed } from "../lib/format.ts";
import { renderOutcomes } from "../lib/outcomes.ts";
import * as routes from "../lib/routes.ts";

const { bundle } = loadFeed();
const o = bundle.statewide.outcomes;
---

<Base
  title={NAMES.outcomes.name}
  description={
    o
      ? `Economic disadvantage explains Ohio's attainment measure at ${fixed(o.poverty_vs_performance, 3)}. Every other association is shown against that, with its controlled figure beside it.`
      : "This feed carries no outcome data."
  }
  image={routes.og.page("outcomes")}
  imageAlt="Ohio school funding set against the report-card measures"
  section="outcomes"
>
  <h1>{NAMES.outcomes.name}</h1>
  <p class="lead">
    What districts achieve, and how little of it the funding side explains. Every association here
    is a correlation over {o ? o.districts : 0} districts and none of them identifies an effect.
  </p>

  <Fragment set:html={renderOutcomes(bundle)} />
</Base>
