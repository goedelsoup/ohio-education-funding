---
/**
 * Every district in the feed, in one table.
 *
 * The old page reached a district through a `<select>` of 609 options, which is a control for
 * choosing something you can already name. This is the other half: a reader who wants the
 * districts at the 20-mill floor, or the ten worst-hit by enrollment decline, has no district in
 * mind yet and needs to sort rather than pick.
 *
 * The whole table is in the document. Filtering and sorting are enhancements over markup that is
 * already complete — with no script, every row is present and the browser's own find works.
 */
import Base from "../layouts/Base.astro";
import { loadFeed } from "../lib/feed.ts";
import { count, money, pct } from "../lib/format.ts";
import * as routes from "../lib/routes.ts";
import { yearOf } from "../lib/year.ts";
import { distributionSpec } from "../lib/plot/spec.ts";
import { renderToString } from "../lib/plot/ssr.ts";
import type { District } from "../lib/types.ts";

const { bundle, alphabetical } = loadFeed();

/*
 * The two spans this page's footnote names, read rather than typed.
 *
 * `FY2024 to FY2026` and `FY2023` were literals, and the second is the one worth care: this
 * table's valuation column is `valuation_per_pupil`, which is the **District Profile Report's**
 * figure and not Table SD-1's. Deriving it from Taxation's latest tax year — the obvious thing to
 * reach for on a page full of tax figures — labels a profile number with the other department's
 * year, which is the confusion the denominators card exists to prevent.
 *
 * So it is the profile's own year, matching how `renderDenominators` labels the same field.
 */
const enrollmentSpan = yearOf("enrollment").replace("-", " to ");
const valuationYear = yearOf("profile");
const s = bundle.statewide;

/** A cell whose sort key is not what it displays: dollars with separators, blanks, percentages. */
const sortable = (value: number | null) => (value == null ? "" : String(value));

/*
 * One strip per sortable numeric column.
 *
 * The keys are the `data-sort` values the header buttons already carry, so the script that sorts
 * the table and the markup that reveals a strip name the same column. `name` has no strip: it is
 * the default sort and it is not a quantity.
 *
 * A district missing a measure is dropped rather than plotted at zero — three have no reported
 * poverty share and the enrollment change needs three years of ADM.
 */
const MEASURES = (
  [
    ["adm", "Enrolled ADM", (d: District) => d.adm, (v: number) => count(Math.round(v))],
    ["aid", "State aid per pupil", (d: District) => d.realized_aid_per_pupil, (v: number) => money(v)],
    [
      "guarantee",
      "What the guarantee adds, per pupil",
      (d: District) => (d.on_guarantee ? d.guarantee / Math.max(d.adm, 1) : null),
      (v: number) => money(v),
    ],
    ["valuation", "Assessed valuation per pupil", (d: District) => d.valuation_per_pupil, (v: number) => money(v)],
    [
      "poverty",
      "Economically disadvantaged share",
      (d: District) => d.economically_disadvantaged,
      (v: number) => pct(v, 0),
    ],
    ["enrollment", "Enrollment change", (d: District) => d.enrollment_change, (v: number) => pct(v, 1)],
  ] as const
).map(([key, label, read, format]) => {
  const values = bundle.districts
    .map((d) => ({ d, v: read(d) }))
    .filter((row): row is { d: District; v: number } => row.v != null && Number.isFinite(row.v))
    .map(({ d, v }) => ({ value: v, hover: `${d.name}: ${format(v)}` }));
  const sorted = values.map((v) => v.value).sort((a, b) => a - b);
  return {
    key,
    label,
    chart: renderToString(distributionSpec(values), { label: `${label} across ${count(values.length)} districts, from ${format(sorted[0] ?? 0)} to ${format(sorted[sorted.length - 1] ?? 0)}` }),
    low: format(sorted[0] ?? 0),
    high: format(sorted[sorted.length - 1] ?? 0),
  };
});
---

<Base
  title="Districts"
  description={`All ${s.districts} Ohio school districts in the FY${bundle.fiscal_year} funding model, with state aid per pupil, guarantee status, property wealth and enrollment.`}
  image={routes.og.page("districts")}
  imageAlt="Every Ohio school district, with how many are funded by the guarantee"
  section="districts"
  wide
>
  <h1>Districts</h1>
  <p class="sub">
    All {count(s.districts)} districts in the department's FY{bundle.fiscal_year} model.
    {" "}{count(s.on_guarantee)} are held above what the formula computes for them by the guarantee;
    {" "}{count(s.at_millage_floor)} are at or below the 20-mill floor;
    {" "}{count(s.at_minimum_state_share)} are at the minimum state share. The median district has
    lost{" "}
    {pct(s.median_millage_reduction, 0)} of the millage its voters approved to H.B. 920.
  </p>

  {/*
      What the column you are sorting by looks like across all 609.
    *
    * Six strips rendered at build and one shown, exactly as `BasisToggle` renders both dollar
    * bases and lets a sibling selector choose — see `app.css`. The alternative was drawing one in
    * the browser when the sort changes, which would put Observable Plot on this page for the sake
    * of a 46px strip: roughly 100 KB gzipped, on the route most likely to be someone's first.
    *
    * So the reader with no script gets the aid distribution, which is this site's central measure
    * and the honest default for a page that has not been sorted; the reader with script gets the
    * strip following their sort. Nothing here needs script to be complete.
  */}
  <div class="measures" id="district-measures" data-measure="aid">
    {
      MEASURES.map((m) => (
        <div class="measure" data-measure={m.key}>
          <p class="note">
            {m.label} across all {count(s.districts)} districts. The shaded box is the middle half;
            the dots past the whiskers are districts of their own.
          </p>
          <div class="chartwrap" set:html={m.chart} />
          <div class="scale">
            <span>{m.low}</span>
            <span>{m.high}</span>
          </div>
        </div>
      ))
    }
  </div>

  <form class="filters" id="district-filters" role="search">
    <div class="field">
      <label for="f-name">Name or IRN</label>
      <input id="f-name" type="search" placeholder="Cleveland, 043786…" autocomplete="off" />
    </div>
    <div class="field">
      <label for="f-status">Funding status</label>
      <select id="f-status">
        <option value="">Any</option>
        <option value="guarantee">On the guarantee</option>
        <option value="formula">On formula</option>
        <option value="floor">At the 20-mill floor</option>
        <option value="minshare">At the minimum state share</option>
        <option value="shrinking">Enrollment falling</option>
      </select>
    </div>
    <p class="count" id="f-count" aria-live="polite">{count(s.districts)} districts</p>
  </form>

  <div class="scroll">
    <table id="district-table">
      <thead>
        <tr>
          <th><button type="button" data-sort="name" aria-sort="ascending">District</button></th>
          <th><button type="button" data-sort="adm">Enrolled ADM</button></th>
          <th><button type="button" data-sort="aid">State aid / pupil</button></th>
          <th><button type="button" data-sort="guarantee">From guarantee</button></th>
          <th><button type="button" data-sort="valuation">Valuation / pupil</button></th>
          <th><button type="button" data-sort="poverty">Econ. disadv.</button></th>
          <th><button type="button" data-sort="enrollment">Enrollment Δ</button></th>
        </tr>
      </thead>
      <tbody>
        {
          alphabetical.map((d) => {
            const guaranteePP = d.realized_aid_per_pupil - d.formula_aid_per_pupil;
            return (
              <tr
                data-name={`${d.name.toLowerCase()} ${d.irn}`}
                data-guarantee={d.on_guarantee ? "1" : ""}
                data-floor={d.at_millage_floor ? "1" : ""}
                data-minshare={d.at_minimum_state_share ? "1" : ""}
                data-shrinking={d.enrollment_change != null && d.enrollment_change < 0 ? "1" : ""}
              >
                <th scope="row" data-sort-value={d.name}>
                  <a href={routes.district(d.irn)}>{d.name}</a>
                  <span class="n"> {d.irn}</span>
                </th>
                <td data-sort-value={d.adm}>{count(Math.round(d.adm))}</td>
                <td data-sort-value={d.realized_aid_per_pupil}>
                  {money(d.realized_aid_per_pupil)}
                </td>
                <td data-sort-value={guaranteePP}>
                  {d.on_guarantee ? money(guaranteePP) : "—"}
                </td>
                <td data-sort-value={sortable(d.valuation_per_pupil)}>
                  {money(d.valuation_per_pupil)}
                </td>
                <td
                  data-sort-value={sortable(d.economically_disadvantaged)}
                >
                  {pct(d.economically_disadvantaged, 1)}
                </td>
                <td
                  data-sort-value={sortable(d.enrollment_change)}
                  class={d.enrollment_change != null && d.enrollment_change < 0 ? "loss" : ""}
                >
                  {pct(d.enrollment_change, 1)}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>

  <p class="note">
    State aid per pupil is what the district receives; the guarantee column is how much of it the
    formula did not compute. Enrolled ADM is the base cost count — the greater of the three-year
    average and the current year. Enrollment change is {enrollmentSpan}, of which the last year is partly
    a departmental estimate. Property valuation is {valuationYear} and is missing for three districts.
  </p>

  <script>
    import "../scripts/districts.ts";
  </script>
</Base>
