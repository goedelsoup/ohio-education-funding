---
/**
 * The long view, and the only route on this site that reaches before FY2020.
 *
 * It is deliberately not folded into the statewide page. Everything there is the Fair School
 * Funding Plan computing one year for 609 traditional districts; everything here is the Census
 * Bureau surveying roughly 950 Ohio systems a year on its own definitions. The two do not
 * reconcile, and a reader who met them in one card would subtract one from the other.
 *
 * The dollar figures carry the same nominal / constant-dollar switch as every other financial
 * view, and they need it more: CPI-U rose 37% across this panel, so the nominal and real
 * statements about the equity gap are different claims.
 */
import BasisToggle from "../components/BasisToggle.astro";
import Base from "../layouts/Base.astro";
import { loadFeed } from "../lib/feed.ts";
import {
  renderAbsent,
  renderEqualization,
  renderProvenance,
  renderRevenueMix,
} from "../lib/history.ts";
import { renderAppropriations } from "../lib/appropriations.ts";
import { renderLineOrigins } from "../lib/lineOrigins.ts";
import { renderMealProgram } from "../lib/mealProgram.ts";
import { baseYear } from "../lib/real.ts";
import * as routes from "../lib/routes.ts";
import { yearOf } from "../lib/year.ts";

const { bundle } = loadFeed();

/*
 * Where the rest of the site starts, read rather than asserted.
 *
 * "The only figures that reach before FY2020" is a claim about every *other* route, and FY2020 is
 * the first year of the five-year forecast panel — the earliest anything on the formula side
 * reaches. Written out, it would go wrong the day a source extends backward, which is exactly what
 * happened to the MR-81 label this same phase corrected.
 */
const formulaEraBegins = yearOf("finances").replace(/^FY/, "").split("-")[0] ?? "";
const history = bundle.history;
const meal = bundle.meal_program;
const appropriations = bundle.appropriations;
const lines = bundle.appropriation_lines;
const base = bundle.deflator
  ? baseYear(
      bundle.deflator,
      history.map((y) => y.fiscal_year),
    )
  : null;

const first = history[0];
const last = history[history.length - 1];

/**
 * The oldest year anything on this page reaches.
 *
 * Two panels with different spans, so the sentence at the top cannot name either one's first
 * year and be true. MR-81 starts in FY2001 and the Census panel in FY2009; taking the minimum
 * means the claim stays right if either series is extended or absent.
 */
const earliest = Math.min(
  ...[first?.fiscal_year, meal[0]?.fiscal_year, appropriations[0]?.fiscal_year].filter(
    (y) => y != null,
  ),
);

/**
 * The base year for the appropriation card, computed over its own span rather than the panel's.
 *
 * `baseYear` picks the most recent year the index covers across the years it is given, and the
 * appropriation series runs four years past the Census panel. Passing the panel's years would
 * restate a twenty-six-year series into a base chosen for a fourteen-year one.
 */
const appropriationBase = bundle.deflator
  ? baseYear(
      bundle.deflator,
      appropriations.map((y) => y.fiscal_year),
    )
  : null;
---

<Base
  title="History"
  description={
    first && last
      ? `Ohio's state share of school revenue fell from ${(first.state_share * 100).toFixed(1)}% in FY${first.fiscal_year} to ${(last.state_share * 100).toFixed(1)}% in FY${last.fiscal_year}, on the Census Bureau's survey of every comparable school system in the state.`
      : "This feed carries no historical panel."
  }
  image={routes.og.page("history")}
  imageAlt="Four regimes of Ohio school funding, and what each one paid"
  section="history"
>
  <h1>The long view</h1>
  <p class="sub">
    {
      first && last
        ? `What Ohio's schools took in and from whom, FY${first.fiscal_year} through FY${last.fiscal_year}, measured by the federal government rather than by the state — and what the formula's poverty weight is counted on, back to FY${earliest}. The only figures on this site that reach before FY${formulaEraBegins}.`
        : "This feed carries no historical panel."
    }
  </p>

  {
    history.length === 0 ? (
      <Fragment set:html={renderAbsent()} />
    ) : (
      <>
        <Fragment set:html={renderProvenance(bundle)} />
        <Fragment set:html={renderRevenueMix(history)} />

        <BasisToggle id="history-basis" section="equity-gap" base={base}>
          <Fragment
            slot="nominal"
            set:html={renderEqualization(history, bundle.deflator, base, "nominal")}
          />
          <Fragment
            slot="real"
            set:html={renderEqualization(history, bundle.deflator, base, "real")}
          />
        </BasisToggle>

  {/* What the totals above are made of. No dollars here, so no basis toggle. */}
  <Fragment set:html={renderLineOrigins(lines)} />
      </>
    )
  }

  {/* Outside the `history.length` gate: a different source, absent for its own reasons. */}
  <Fragment set:html={renderMealProgram(meal)} />

  {/*
    The plain toggle, not a real-first variant. `BasisToggle` states that neither basis is the
    default truth and is built symmetric on purpose; making this the one card that opens in
    constant dollars would be the editorial claim the component declines to make. The card's own
    prose carries the point instead.
  */}
  <BasisToggle id="appropriation-basis" section="appropriations" base={appropriationBase}>
    <Fragment
      slot="nominal"
      set:html={renderAppropriations(appropriations, bundle.deflator, appropriationBase, "nominal")}
    />
    <Fragment
      slot="real"
      set:html={renderAppropriations(appropriations, bundle.deflator, appropriationBase, "real")}
    />
  </BasisToggle>
</Base>
