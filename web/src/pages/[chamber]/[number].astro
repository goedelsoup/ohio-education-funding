---
/**
 * One Ohio legislative seat: the school districts in it, and the funding apportioned to it.
 *
 * The members table carries two shares that answer opposite questions — how much of the school
 * district is here, and how much of here is that school district. Showing one without the other is
 * the mistake this page is most likely to invite.
 */
import Base from "../../layouts/Base.astro";
import { loadFeed } from "../../lib/feed.ts";
import { count, money, pct } from "../../lib/format.ts";
import * as routes from "../../lib/routes.ts";
import { yearChip } from "../../lib/year.ts";
import SectionAnchor from "../../components/SectionAnchor.astro";
import { BOX_FROM, distributionSpec } from "../../lib/plot/spec.ts";
import { renderToString } from "../../lib/plot/ssr.ts";

export async function getStaticPaths() {
  const { bundle } = loadFeed();
  return [
    ...bundle.house_districts.map((house) => ({
      params: { chamber: "house", number: house.number },
      props: { house, chamber: "house" as const },
    })),
    ...bundle.senate_districts.map((house) => ({
      params: { chamber: "senate", number: house.number },
      props: { house, chamber: "senate" as const },
    })),
  ];
}

const { house, chamber } = Astro.props;
const { bundle } = loadFeed();
const seats = chamber === "house" ? bundle.house_districts : bundle.senate_districts;
const label = chamber === "house" ? "House" : "Senate";
const statewideAid = seats.reduce((a, h) => a + h.realized_aid, 0);
const number = Number(house.number);
const partial = house.members.length - house.districts_wholly_inside;

/*
 * The seat's districts by tax base, drawn rather than only listed.
 *
 * `house.members` carries the IRNs; the valuation lives on the district records, so the two are
 * joined here. A member whose district is not in the funding model, or which reports no valuation,
 * is dropped rather than plotted at zero.
 */
const byIrn = new Map(bundle.districts.map((d) => [d.irn, d]));
const spreadValues = house.members
  .map((m) => byIrn.get(m.irn))
  .filter((d): d is NonNullable<typeof d> => d != null && d.valuation_per_pupil != null)
  .map((d) => ({
    value: d.valuation_per_pupil!,
    hover: `${d.name}: ${money(d.valuation_per_pupil!)} per pupil, ${money(d.realized_aid_per_pupil)} state aid per pupil`,
  }));
const spreadCount = spreadValues.length;
const spread = renderToString((w) => distributionSpec(spreadValues, { width: w }), { label: `Assessed valuation per pupil across the ${spreadCount} districts in ${label} District ${number} with a reported tax base, poorest to wealthiest` });
/*
 * The two ends of the strip, and the column the strip is drawn from.
 *
 * `distributionSpec` draws no axis by construction — every other strip on the site states its
 * scale in a `.scale` row underneath, and these 129 pages drew the dots with no axis, no scale row
 * and no valuation column in the table below, which left a reader nothing to recover a value with.
 * A dot at four fifths of the width meant nothing at all.
 *
 * `sortedSpread` is the same array the chart is drawn from, so the two ends named here are the two
 * ends drawn — not a min and max taken again off a different filter.
 */
const sortedSpread = [...spreadValues].sort((a, b) => a.value - b.value);
const spreadLow = sortedSpread[0]?.value ?? null;
const spreadHigh = sortedSpread[sortedSpread.length - 1]?.value ?? null;
const valuationByIrn = new Map(
  house.members.map((m) => [m.irn, byIrn.get(m.irn)?.valuation_per_pupil ?? null]),
);
---

<Base
  title={`${label} District ${number}`}
  description={`Ohio ${label} District ${number}: the ${house.members.length} school districts in it and an estimated ${money(house.realized_aid)} of state aid apportioned from census blocks.`}
  image={routes.og.chamberDistrict(chamber, house.number)}
  imageAlt={`Ohio ${label} District ${number}: the school districts in it and the state aid apportioned to them`}
  section={chamber}
  wide
>
  <h1>{label} District {number}</h1>
  <p class="sub">
    {count(house.members.length)} school district{house.members.length === 1 ? "" : "s"}
    {house.districts_wholly_inside > 0 ? `, ${count(house.districts_wholly_inside)} of them wholly inside` : ""}
    {" "}· an estimated {count(Math.round(house.adm))} pupils
    {" "}{house.districts_on_guarantee > 0 ? ` · ${count(house.districts_on_guarantee)} on the guarantee` : ""}
  </p>

  <p class="note"><a href={`/${chamber}`}>All {seats.length} {label} districts</a>. Every figure
    here is apportioned from census blocks and is an estimate — see the note on that page.
    {" "}{chamber === "senate"
      ? " Senate seats are three times larger than House seats, so more of their schools lie wholly inside them and the estimate is correspondingly tighter."
      : ""}</p>

  <div class="card" id="apportioned" data-part="apportioned">
    <h2><SectionAnchor id="apportioned" />Apportioned funding<Fragment set:html={yearChip("formula")} /></h2>
    <div class="scroll"><table>
      <thead><tr><th>Measure</th><th class="tnum">Estimate</th><th>What it is</th></tr></thead>
      <tbody>
        <tr class="current"><th>State aid</th><td class="tnum">{money(house.realized_aid)}</td>
          <td class="n">{pct(house.realized_aid / statewideAid, 2)} of Ohio's school aid.</td></tr>
        <tr><th>State share of base cost</th><td class="tnum">{money(house.base_cost_state_share)}</td>
          <td class="n">The half the statutory build-up computes.</td></tr>
        <tr><th>Categorical funding</th><td class="tnum">{money(house.categorical_funding)}</td>
          <td class="n">Targeted assistance, special education, DPIA, gifted, CTE, English learners.</td></tr>
        <tr><th>Guarantee</th>
          <td class="tnum">{house.guarantee <= 0 ? "—" : money(house.guarantee)}</td>
          <td class="n">{house.guarantee <= 0
            ? "No district here is held above its formula amount."
            : "Aid the formula does not justify, held in place by the transitional guarantee."}</td></tr>
        <tr><th>Pupils</th><td class="tnum">{count(Math.round(house.adm))}</td>
          <td class="n">Apportioned enrolled ADM, not a count of children in the district.</td></tr>
      </tbody>
    </table></div>
  </div>

  <div class="card" id="members" data-part="members">
    <h2><SectionAnchor id="members" />The school districts here<Fragment set:html={yearChip("formula")} /></h2>
    {
      /*
       * The seat's schools by the tax base each of their pupils stands on, one dot each.
       *
       * A seat is a peer group in the same sense a county is — the districts in it share a
       * legislator and nothing else — and the table below it is sorted by share of the seat, which
       * is the right order for "whose district is this" and the wrong one for "how far apart are
       * they". Dots rather than a box: most seats hold a handful of districts.
       */
      spread && (
        <>
          <p class="note">
            Assessed valuation per pupil across the {spreadCount} districts here with a reported
            tax base, poorest on the left.
            {" "}{spreadCount >= BOX_FROM ? " The shaded box is the middle half of them." : ""}
          </p>
          <div class="chartwrap" data-chart="seat-spread" set:html={spread} />
          <div class="scale">
            <span>{money(spreadLow)}</span>
            <span>{money(spreadHigh)}</span>
          </div>
        </>
      )
    }
    <div class="scroll"><table>
      <thead><tr>
        <th>District</th><th class="tnum">Of the district</th><th class="tnum">Of this seat</th>
        <th class="tnum">Pupils</th><th class="tnum">Valuation per pupil</th>
        <th class="tnum">State aid</th>
      </tr></thead>
      <tbody>
        {house.members.map((m) => (
          <tr class={m.wholly_inside ? "current" : undefined}>
            <th><a href={routes.district(m.irn)}>{m.name}</a>
              {m.wholly_inside ? <div class="n">Entirely inside this House district</div> : null}</th>
            <td class="tnum">{pct(m.share, 1)}</td>
            <td class="tnum">{pct(m.share_of_house_district, 1)}</td>
            <td class="tnum">{count(Math.round(m.adm))}</td>
            {/* The measure the strip above is drawn from, so a dot can be read back to a row.
                An em dash where the district reports none — the same districts the strip drops. */}
            <td class="tnum">{money(valuationByIrn.get(m.irn))}</td>
            <td class="tnum">{money(m.realized_aid)}</td>
          </tr>
        ))}
      </tbody>
    </table></div>
    <p class="note">
      The two share columns answer opposite questions and are easy to confuse. <strong>Of the
      district</strong> is how much of that school district lies in this House district — 100% means
      the member speaks for all of it. <strong>Of this seat</strong> is how much of this House
      district's pupils that school district provides.
      {" "}{partial > 0
        ? partial === house.members.length
          ? ` Every district here also lies in other ${label} districts, so all of these pupils and all of this money are counted here only in part.`
          : ` ${count(partial)} of these ${count(house.members.length)} districts also ${partial === 1 ? "lies" : "lie"} in other House districts, so ${partial === 1 ? "its" : "their"} pupils and money are counted here only in part.`
        : " Every district here lies wholly inside this House district, which is unusual."}
    </p>
  </div>
</Base>
