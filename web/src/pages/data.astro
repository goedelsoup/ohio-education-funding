---
/**
 * The data, for people who want the table rather than the page.
 *
 * Journalists and legislative staff do not want 609 web pages; they want the panel in something
 * that opens in a spreadsheet. Publishing it is nearly free — the feed is already a static file —
 * and withholding it while claiming the figures are checkable would be a contradiction.
 */
import Base from "../layouts/Base.astro";
import { NAMES } from "../lib/nav.ts";
import { loadFeed } from "../lib/feed.ts";
import { count, millions } from "../lib/format.ts";
import * as routes from "../lib/routes.ts";
import { yearChip } from "../lib/year.ts";
import { modelSource } from "../lib/modelSource.ts";
import SectionAnchor from "../components/SectionAnchor.astro";

const { bundle, verification } = loadFeed();
const s = bundle.statewide;

/**
 * This page, as a `schema.org/Dataset`.
 *
 * The only JSON-LD on the site, and the only page that earns it. Everywhere else the structured
 * data would restate the `<title>` and the description already in the head, which is markup for
 * its own sake. Here it is a genuinely different statement: three files, at fixed URLs, with
 * stated media types and byte sizes, versioned by a contract number — machine-readable facts a
 * dataset index can act on, and which the prose below states in a form that only a reader can.
 *
 * Everything in it is read from the feed rather than typed. The three `distribution` URLs are the
 * three `<a href>`s in the table below; `version` is the bundle's own contract version, so a
 * breaking change to the feed's shape changes what this claims about it in the same build; and
 * the temporal coverage is the formula series' own year. A hand-written block would go stale the
 * first time any of those moved, silently, because nothing on the page renders it.
 *
 * `sdPublisher` rather than `publisher`: the *figures* are the department's public records, and
 * this project's contribution is the joining and the re-computation — the distinction `/data`'s
 * own Terms card makes in prose. Claiming to publish the underlying records would be a stronger
 * claim than the page beside it makes.
 */
const site = Astro.site ?? new URL("https://ohio-education-funding.pages.dev");

/**
 * A line to copy into a story (#595).
 *
 * The Terms below ask anyone publishing a figure to name its year and basis, and gave nothing to
 * paste that did. So the line carries all three things a citation of this site needs — the model
 * year, the dollar basis and the address — and the date of the calculator the figures come from,
 * read from its catalog entry like the footer's. It names this page and nominal dollars because
 * those are what the files here are; the note under it says what to change for one page.
 */
const model = modelSource(bundle.fiscal_year);
const citation =
  `Ohio school funding, FY${bundle.fiscal_year} model, nominal dollars. ${new URL("/data", site).href}. ` +
  `Data: Ohio Department of Education and Workforce, FY${bundle.fiscal_year} funding calculator, dated ${model.date}.`;
const formulaYear = bundle.series_years.find((entry) => entry.series === "formula");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "Ohio school funding panel",
  description: `Every Ohio school district under the Fair School Funding Plan: formula and realized state aid, the base cost build-up, the guarantee, assessed valuation and millage, spending, and report card outcomes. ${s.districts} districts, FY${bundle.fiscal_year}.`,
  url: new URL("/data", site).href,
  version: bundle.contract_version,
  isAccessibleForFree: true,
  creator: { "@type": "Organization", name: "Ohio school funding" },
  sdPublisher: { "@type": "Organization", name: "Ohio school funding" },
  spatialCoverage: { "@type": "State", name: "Ohio" },
  ...(formulaYear ? { temporalCoverage: formulaYear.label } : {}),
  measurementTechnique: bundle.provenance,
  distribution: [
    {
      "@type": "DataDownload",
      name: "districts.csv",
      description: `One row per district — ${s.districts} rows — of the figures this site renders.`,
      encodingFormat: "text/csv",
      contentUrl: new URL("/data/districts.csv", site).href,
    },
    {
      "@type": "DataDownload",
      name: "bundle.json",
      description:
        "The complete feed, exactly as the build reads it: districts, statewide aggregates, finances, outcomes, tax base, the national comparison and the reference checkpoints.",
      encodingFormat: "application/json",
      contentUrl: new URL("/data/bundle.json", site).href,
    },
    {
      "@type": "DataDownload",
      name: "panel.json",
      description:
        "The same feed with the finances and report-card blocks removed — the formula inputs alone.",
      encodingFormat: "application/json",
      contentUrl: new URL("/data/panel.json", site).href,
    },
  ],
};
---

<Base
  title={NAMES.data.name}
  description="Download the Ohio school funding panel: the full feed as JSON, the formula inputs alone, and the district table as CSV."
  image={routes.og.page("data")}
  imageAlt="The Ohio school funding panel, as JSON and CSV"
  section="data"
  jsonLd={jsonLd}
>
  <h1>{NAMES.data.name}</h1>
  <p class="lead">
    Everything this site renders, in the form it renders it from. No registration, no API key,
    static files.
  </p>

  <div class="card" id="downloads" data-part="downloads">
    <h2><SectionAnchor id="downloads" />Downloads</h2>
    <div class="scroll">
      <table class="prose">
        <tbody>
          <tr>
            <th><a href="/data/districts.csv">districts.csv</a></th>
            <td>
              One row per district — {count(s.districts)} rows. Funding, wealth, enrollment,
              outcomes and the latest closed year of actuals. The file to open in a spreadsheet.
            </td>
          </tr>
          <tr>
            <th><a href="/data/bundle.json">bundle.json</a></th>
            <td>
              The complete feed, exactly as <code>crates/bundle</code> writes it and as this site
              is built from: districts, statewide aggregates, six years of audited finances per
              district, report card outcomes, the base cost build-up, two tax years of Table SD-1
              property values and charges, operating spending by function, the H.B. 920 reduction
              computed against both, the fifty-one-state Census comparison, the price index, and
              the reference checkpoints.
            </td>
          </tr>
          <tr>
            <th><a href="/data/panel.json">panel.json</a></th>
            <td>
              The same feed with the finances and report-card blocks removed — the formula inputs
              alone. This is what the scenario routes fetch, and it is a third the size.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card" id="checkpoints" data-part="checkpoints">
    <h2><SectionAnchor id="checkpoints" />The checkpoints<Fragment set:html={yearChip("formula")} /></h2>
    <p class="note">
      The feed carries {verification.comparisons.length} scenarios computed by{" "}
      <code>crates/project</code>, and this site will not build unless its own implementation
      reproduces every one. They are in <code>bundle.json</code> under <code>checkpoints</code>, and
      they are the most useful thing in the file for anyone checking the arithmetic: each is a
      complete policy, its statewide cost, and the counts of districts that gain, lose and do not
      move. <a href="/method">What that check is for</a>.
    </p>
    <div class="scroll">
      <table>
        <thead>
          <tr><th>Scenario</th><th>Cost</th><th>Up</th><th>Down</th><th>Unmoved</th></tr>
        </thead>
        <tbody>
          {
            bundle.checkpoints.map((checkpoint) => (
              <tr>
                <th>{checkpoint.label}</th>
                <td class="tnum">
                  {millions(checkpoint.realized_aid).replace("+", "")}
                </td>
                <td class="tnum">{checkpoint.gainers}</td>
                <td class="tnum">{checkpoint.losers}</td>
                <td class="tnum">{checkpoint.unmoved}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <div class="card" id="terms" data-part="terms">
    <h2><SectionAnchor id="terms" />Terms</h2>
    <p class="note">
      The underlying figures are public records published by the Ohio Department of Education and
      Workforce and the Ohio Department of Taxation; this site's contribution is the joining, the
      re-computation and the checking, and none of that is proprietary. Use it. If you publish a
      figure from here, say which fiscal year and which basis it is on — the same figure in nominal
      and constant dollars supports opposite arguments, and this site shows both for that reason.
    </p>
    <p class="note">{bundle.provenance}</p>
  </div>

  <div class="card" id="cite" data-part="cite">
    <h2><SectionAnchor id="cite" />How to cite</h2>
    <p class="citation">{citation}</p>
    <p class="note">
      Citing a figure from one page, give that page's address instead, and write "constant dollars"
      with the year the page names if you read the figure in them. A wrong figure is worth telling
      us about: the footer of every page has a link for it.
    </p>
  </div>
</Base>
