---
/**
 * One corpus node.
 *
 * The description, its properties, what it points at, and — the part a file on disk cannot give
 * you — what points back at it. A corpus is a graph, and the backlink list is the half of each
 * edge that is invisible while authoring.
 *
 * Where a node names a district this repository holds live figures for, the two are joined: the
 * corpus says what the district illustrates, the district page says what it is currently paid.
 * That join is the reason the wiki is on the same site as the data rather than beside it.
 */
import Base from "../../../layouts/Base.astro";
import { loadCorpus } from "../../../lib/corpus.ts";
import { loadFeed } from "../../../lib/feed.ts";
import { money } from "../../../lib/format.ts";
import { renderProse, renderPropertyValue } from "../../../lib/prose.ts";
import * as routes from "../../../lib/routes.ts";
import SectionAnchor from "../../../components/SectionAnchor.astro";

export function getStaticPaths() {
  return loadCorpus().nodes.map((node) => ({
    params: { class: node.className, node: node.name },
    props: { node },
  }));
}

const { node } = Astro.props;
const corpus = loadCorpus();
const entry = corpus.byClass.get(node.className);
const description = await renderProse(node.description, node.className);
const findings = node.findings ? await renderProse(node.findings, node.className) : null;

/*
 * The withdrawals, rendered as prose because every field in one of them is prose.
 *
 * `found_by` is a link in nearly every entry — a Rust test path, a catalog record — so it goes
 * through the same processor the body does rather than being printed as a string. Awaited up here
 * in a batch because the markdown processor is async and the template is not.
 */
const revisions = await Promise.all(
  node.revisions.map(async (revision) => ({
    was: await renderProse(revision.was, node.className),
    now: await renderProse(revision.now, node.className),
    foundBy: await renderProse(revision.found_by, node.className),
    reach: revision.reach ? await renderProse(revision.reach, node.className) : null,
  })),
);

/**
 * The live district behind an exemplar node, where there is one.
 *
 * Five of the seven `education-agency` nodes carry an IRN that is in the feed. The IRN is written
 * with its claim tag attached — `044933 [verified — …]` — so it is pulled out by pattern rather
 * than read as a field.
 */
const { byIrn } = loadFeed();
const irn = node.properties.find((p) => p.name === "irn")?.value.match(/\b(\d{6})\b/)?.[1];
const district = irn ? byIrn.get(irn) : undefined;

const stated = node.out.filter((edge) => edge.stated);
const mentions = node.out.filter((edge) => !edge.stated);

/*
 * Why a node is in the corpus at all, held apart from what the node says about Ohio.
 *
 * This used to be a clause in the middle of the first sentence — "A high-wealth suburban district
 * in Franklin County, adjacent to Columbus, seeded as the contrast case against …" — so a reader
 * who came to find out what the district is met an editorial note about why it had been entered.
 * It is genuine provenance and worth keeping; it is just not body copy, and the class index that
 * summarised that sentence inherited the problem.
 */
/*
 * The draft behind a `draft-legislation` node, where the feed carries one.
 *
 * The card below links into the scenario runner, and it states the priced ratio rather than only
 * offering the link — an invitation to see a bill's cost should carry, at the point of the
 * invitation, the fact that the cost is of some of its clauses. `crates/project` refuses to print
 * one without the other and the runner repeats the refusal; this is the third place, and it is
 * the one a reader meets first.
 */
const draft = loadFeed().bundle.drafts.find((d) => d.slug === node.name);
const unpriced = draft?.provisions.filter((p) => p.lever === "").length ?? 0;

const seeded = node.properties.find((p) => p.name === "seeded_because");
const properties = node.properties.filter((p) => p.name !== "seeded_because");
---

<Base
  title={node.label}
  description={node.summary}
  image={routes.og.wikiNode(node.className, node.name)}
  imageAlt={`${node.label}, a node in the Ohio school funding corpus`}
  section="wiki"
>
  <p class="crumb">
    <a href="/wiki">The corpus</a> ›{" "}
    <a href={routes.wikiClass(node.className)}>{entry?.label ?? node.className}</a>
  </p>
  <h1>{node.label}</h1>
  {/* The lead, ahead of everything including the identifier. A reader arriving at the longest
      node in the corpus used to meet 2,806 words before finding out what the thing was. */}
  <p class="lead">{node.summary}</p>
  <p class="sub">
    <code>{node.id}</code>
    {node.in.length > 0 ? ` · ${node.in.length} node${node.in.length === 1 ? "" : "s"} point here` : ""}
    {node.revisions.length > 0
      ? ` · ${node.revisions.length} correction${node.revisions.length === 1 ? "" : "s"}`
      : ""}
  </p>

  {
    draft && (
      <div class="card" id="runner" data-part="runner">
        <h2><SectionAnchor id="runner" />This draft, in the scenario runner</h2>
        <p class="note">
          {draft.provisions.length - unpriced} of this draft&apos;s {draft.provisions.length}
          {" "}provisions bind a lever in the FY{loadFeed().bundle.fiscal_year} model, so they can
          be run across all 609 districts.
          {" "}{unpriced > 0
            ? ` The other ${unpriced} set no lever: whatever the runner shows is the cost of ${draft.provisions.length - unpriced} clauses and not of the bill.`
            : " There are none it cannot run, which is a property of a one-clause draft rather than of drafts."}
        </p>
        <div class="flags">
          <a class="flag" href={routes.scenarioDraft(draft.slug)}>Open in the scenario runner</a>
        </div>
      </div>
    )
  }

  {
    district && (
      <div class="card" id="district" data-part="district">
        <h2><SectionAnchor id="district" />This district, in the current model</h2>
        <p class="note">
          The corpus says what {district.name} illustrates. The FY{loadFeed().bundle.fiscal_year}
          {" "}model says what it is paid: {money(district.realized_aid_per_pupil)} per pupil,
          {" "}{district.on_guarantee ? " held there by the guarantee." : " all of it from the formula."}
        </p>
        <div class="flags">
          {/* All five, in the order the district sub-navigation puts them. Property tax was
              omitted here for six phases after it was built — it is the heaviest of the five and
              the one an exemplar district's page has most reason to reach, since a district is an
              exemplar in this corpus largely on account of its tax base. */}
          <a class="flag" href={routes.district(district.irn)}>Dashboard</a>
          <a class="flag" href={routes.districtOutcome(district.irn)}>Outcome</a>
          <a class="flag" href={routes.districtFinances(district.irn)}>Finances</a>
          <a class="flag" href={routes.districtTaxes(district.irn)}>Property tax</a>
          <a class="flag" href={routes.districtScenario(district.irn)}>Scenario</a>
        </div>
      </div>
    )
  }

  <div class="card prose-body" id="description" data-part="description"><Fragment set:html={description} /></div>

  {
    findings && (
      <div class="card prose-body" id="findings" data-part="findings">
        <h2><SectionAnchor id="findings" />What this repository computed</h2>
        <p class="note">
          Not what Ohio publishes. Figures derived here from committed fixtures, each one citing
          the test that reproduces it.
        </p>
        <Fragment set:html={findings} />
      </div>
    )
  }

  {
    properties.length > 0 && (
      <div class="card" id="properties" data-part="properties">
        <h2><SectionAnchor id="properties" />Properties</h2>
        <div class="scroll">
          <table class="prose">
            <tbody>
              {properties.map((property) => (
                <tr>
                  <th>
                    <code>{property.name}</code>
                  </th>
                  <td set:html={renderPropertyValue(property.value, node.className)} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )
  }

  <div class="card" id="links" data-part="links">
    <h2><SectionAnchor id="links" />Links</h2>
    {
      stated.length > 0 && (
        <div class="scroll">
          <table class="prose">
            <tbody>
              {stated.map((edge) => (
                <tr>
                  <th>
                    <code>{edge.relationship ?? "links to"}</code>
                  </th>
                  <td>
                    <a href={edge.href}>{edge.label}</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
    {
      mentions.length > 0 && (
        <>
          <h3>Also mentions</h3>
          <div class="flags">
            {mentions.map((edge) => (
              <a class="flag" href={edge.href}>
                {edge.label}
              </a>
            ))}
          </div>
        </>
      )
    }
    {
      node.in.length > 0 && (
        <>
          <h3>Pointed at by</h3>
          <div class="scroll">
            <table class="prose">
              <tbody>
                {node.in.map((edge) => (
                  <tr>
                    <th>
                      <a href={edge.href}>{edge.label}</a>
                    </th>
                    <td>
                      {edge.relationship ? <code>{edge.relationship}</code> : <span class="n">mentions</span>}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )
    }
    {
      node.out.length === 0 && node.in.length === 0 && (
        <p class="note">
          Nothing links to or from this node. The corpus treats that as a gap rather than a fact
          about the node.
        </p>
      )
    }
  </div>

  {
    /*
     * What this node used to say.
     *
     * Collapsed and not omitted, which is the whole balance this block is trying to strike. A
     * withdrawn claim set in body copy above the current one is how a reader ends up quoting the
     * wrong figure; a withdrawn claim deleted is how the next author re-derives it. The genres
     * were interleaved in `description:` until
     * `.yidam/decisions/the-four-genres-of-a-description.yml`, and 130 of these were shouting in
     * capitals to win a skimming reader's attention against 2,000 words of body copy.
     *
     * Open by default when there is exactly one: a lone `<details>` costs a reader a click to
     * find out it held a paragraph, and on the nodes with several the list is the point.
     */
    node.unfilled.length > 0 && (
      /*
       * What the node does not hold, in the position the content would occupy.
       *
       * This was four inline badges on a three-mark axis until the migration: `[unentered]` mid
       * sentence, reading as a weaker grade of support than `[open]` because sitting in the
       * sequence is itself the claim that it belongs to the sequence. It does not — an empty field
       * is the absence of a claim to grade rather than a weak one.
       *
       * So it is a block, and it names the missing fact specifically. "The department's typology
       * code: the characterisation is entered, its own code is not" is a to-do somebody can act
       * on; a badge at the end of a sentence is a shrug.
       *
       * Placed after the properties and before the corrections: it is about this node's coverage,
       * which is apparatus, and it belongs with the apparatus rather than in the reading.
       */
      <div class="card" id="unfilled" data-part="unfilled">
        <h2><SectionAnchor id="unfilled" />What this node does not hold</h2>
        {node.unfilled.map((entry) => (
          <p class="unfilled">
            <span class="unfilled-field">{entry.field}</span>
            {entry.why ? ` — ${entry.why}` : " — not yet entered."}
          </p>
        ))}
      </div>
    )
  }
  {
    revisions.length > 0 && (
      <div class="card apparatus" id="revisions" data-part="revisions">
        <h2><SectionAnchor id="revisions" />What this node used to say</h2>
        <p class="note">
          The corpus is not rewritten to have always been right. Each entry is a claim this node
          carried, what replaced it, and the thing that settled it.
        </p>
        {revisions.map((revision, index) => (
          <details class="revision" open={revisions.length === 1}>
            <summary>
              Correction {index + 1} of {revisions.length}
            </summary>
            <div class="revision-body">
              <h3>It said</h3>
              <div class="withdrawn prose-body" set:html={revision.was} />
              <h3>It says</h3>
              <div class="prose-body" set:html={revision.now} />
              <h3>Settled by</h3>
              <div class="prose-body" set:html={revision.foundBy} />
              {revision.reach && (
                <>
                  <h3>What else it touched</h3>
                  <div class="prose-body" set:html={revision.reach} />
                </>
              )}
            </div>
          </details>
        ))}
      </div>
    )
  }

  {
    seeded && (
      <div class="card apparatus" id="why" data-part="why">
        <h2><SectionAnchor id="why" />Why this node is here</h2>
        <p class="note">
          A note from the corpus about itself rather than about Ohio, kept because provenance
          includes why something was written down.
        </p>
        <p set:html={renderPropertyValue(seeded.value, node.className)} />
      </div>
    )
  }
</Base>
