---
/**
 * Two districts, side by side.
 *
 * The corpus is built on contrast pairs — Northern Local and Upper Arlington are `peer-of` each
 * other precisely to make the distributional question concrete, and Toledo against Perrysburg is
 * an entire catalog fact-check. Those arguments are the reason this page exists: a single
 * district's figures are a fact, and two districts' figures are a claim about the system.
 *
 * Rendered in the browser rather than as 185,000 pre-built pairs. The comparison is the one place
 * on this site where the combinatorics genuinely defeat static generation.
 */
import Base from "../layouts/Base.astro";
import { comparison, type Years } from "../lib/compare.ts";
import { loadFeed, qualifiedName } from "../lib/feed.ts";
import { count } from "../lib/format.ts";
import * as routes from "../lib/routes.ts";
import { yearChipPair, yearOf } from "../lib/year.ts";

const { bundle, alphabetical } = loadFeed();

/** The pairs the corpus itself argues from, offered as a way in that is not two dropdowns. */
const SEEDED = [
  { a: "049056", b: "044933", why: "The corpus's own contrast pair: property-poor against property-rich." },
  { a: "044909", b: "045583", why: "The pair behind the department's special-needs spending fact-check." },
  { a: "043786", b: "043802", why: "Ohio's two largest districts, both on the guarantee." },
];
const named = SEEDED.map((pair) => ({
  ...pair,
  aName: alphabetical.find((d) => d.irn === pair.a)?.name ?? pair.a,
  bName: alphabetical.find((d) => d.irn === pair.b)?.name ?? pair.b,
}));

/**
 * The comparison is in the document, for the pair a bare `/compare` is about.
 *
 * It used to be an empty `<div>` filled after a 641 KB download: at 400 Kbps / 400 ms RTT, first
 * paint at 1,284 ms and a table at 4,340 ms. Three seconds of an empty box for seventeen rows.
 * Rendering it here costs one card of HTML and makes the front door of this route complete before
 * any script runs — which is what every other page on this site already promises.
 *
 * The first seeded pair rather than an arbitrary one: it is the corpus's own property-poor against
 * property-rich contrast, it is what `scripts/compare.ts` falls back to, and a reader who arrives
 * with no query is asking this page to make its argument rather than a particular one.
 */
const default_ = SEEDED[0]!;
const side = (irn: string) => {
  const district = bundle.districts.find((d) => d.irn === irn);
  if (!district) {
    throw new Error(
      `/compare is seeded with ${irn}, which is not in the feed. The seeded pairs are the ` +
        `corpus's own contrast arguments, so a missing one is a corpus edit rather than a typo.`,
    );
  }
  return { district, name: qualifiedName(district) };
};
/*
 * Every year the table names, read from the feed rather than written here. `Years` spells its four
 * series out instead of taking a lookup, so a row that wants a fifth has to come through this
 * object — see the rule in `lib/year.ts`.
 */
const years: Years = {
  fiscal: bundle.fiscal_year,
  millage: yearOf("millage"),
  enrollment: yearOf("enrollment"),
  profile: yearOf("profile"),
  spending: yearOf("outcome.spending"),
};
/*
 * Two reckonings in the chip and the third in a row header. The aid rows are the model's FY, the
 * spending row is the report card's, and the valuation row says its own — see `lib/compare.ts`.
 */
const seeded = comparison(
  years,
  side(default_.a),
  side(default_.b),
  yearChipPair("formula", "outcome.spending", "spending"),
);
---

<Base
  title="Compare"
  description={`Put any two of Ohio's ${bundle.statewide.districts} school districts side by side: funding, guarantee status, property wealth, spending and outcomes.`}
  image={routes.og.page("compare")}
  imageAlt="Any two Ohio school districts, side by side"
  section="compare"
>
  <h1>Compare</h1>
  <p class="sub">
    Any two of Ohio's {count(bundle.statewide.districts)} districts, side by side. A single
    district's figures are a fact; two districts' figures are usually the argument.
  </p>

  <div class="card" id="pick" data-part="pick">
    <form class="filters" id="compare-form">
      <div class="field">
        <label for="cmp-a">First district</label>
        <select id="cmp-a">
          {alphabetical.map((d) => <option value={d.irn}>{qualifiedName(d)}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="cmp-b">Second district</label>
        <select id="cmp-b">
          {alphabetical.map((d) => <option value={d.irn}>{qualifiedName(d)}</option>)}
        </select>
      </div>
    </form>
    <p class="note">
      Or start from a pair the corpus already argues from:
    </p>
    <div class="flags">
      {
        named.map((pair) => (
          <a class="flag" href={`/compare?a=${pair.a}&b=${pair.b}`} title={pair.why}>
            {pair.aName} vs {pair.bName}
          </a>
        ))
      }
    </div>
  </div>

  <div id="compare-out" set:html={seeded} />

  <noscript>
    <div class="card" id="needs-script" data-part="needs-script">
      <p class="note">
        The comparison above is the one this page is seeded with, and it is complete without
        JavaScript. <strong>Changing the pair needs it</strong>: there are 185,000 pairs, which is
        more pages than a static site should mint, so the two districts you pick are fetched. Every
        district's own figures are in the document on <a href="/districts">its page</a>, which
        needs nothing.
      </p>
    </div>
  </noscript>

  <script>
    import "../scripts/compare.ts";
  </script>
</Base>
