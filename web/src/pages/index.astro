---
/**
 * The front door, which is not a view of anything.
 *
 * # Why the root stopped being the statewide panel
 *
 * It was the statewide panel for as long as the bar had three axes and every one of them was
 * about money. The bar has five now, two of them lifted out of `.yidam/corpus/` — statute and
 * formula — and neither has anywhere to be introduced on a page that opens with foundation aid
 * totals. A reader landing on a dense financial view has been handed an answer before they asked
 * anything, and the answer is about the one axis they were most likely to find on their own.
 *
 * # It takes no entry in the bar
 *
 * The brand mark points here and nothing else does. That is the convention a reader already has,
 * and a tab as well would put one destination in the bar twice. It also means this page has to
 * earn its place by orienting rather than by being unavoidable: it is three cards, and the reason
 * there is no fourth is that a front door which lists everything is a list, not a door.
 *
 * # Where the figures are
 *
 * One sentence of them, and then a link. Tiles here would be the statewide page rendered twice,
 * and a headline figure on a page with no panel under it is the exact thing this repository keeps
 * catching — a number that travels without the page that qualifies it.
 */
import Base from "../layouts/Base.astro";
import SectionAnchor from "../components/SectionAnchor.astro";
import { loadFeed } from "../lib/feed.ts";
import { count, millions } from "../lib/format.ts";
import { nav } from "../lib/nav.ts";
import * as routes from "../lib/routes.ts";

const { bundle, alphabetical } = loadFeed();
const s = bundle.statewide;
const sections = nav(bundle);

/** The districts a reader is most likely to be looking for, as a way in that is not a table. */
const NOTABLE = ["043802", "043786", "044909", "049056", "044933", "045583"]
  .map((irn) => alphabetical.find((d) => d.irn === irn))
  .filter((d) => d != null);
---

<Base
  title="Ohio school funding"
  description={`What Ohio pays each of its ${s.districts} school districts, what the formula says it should, and what a different decision would do. Generated from the state's own model and a corpus of the statute, litigation and definitions behind it.`}
  image={routes.og.default()}
  imageAlt="Ohio school funding: what the state pays across all 609 districts, and how much of it is guarantee money"
>
  <h1>Ohio school funding</h1>
  <p class="sub">
    What Ohio pays each of its {count(s.districts)} school districts, what the formula says it
    should, and what a different decision would do. The state pays{" "}
    {millions(s.realized_aid_total).replace("+", "")} in foundation aid in FY{bundle.fiscal_year},
    and {s.on_guarantee} districts are funded by the guarantee rather than by the formula —{" "}
    <a href="/statewide">the statewide view</a> is where that is laid out.
  </p>

  <div class="card" id="find-a-district" data-part="find-a-district">
    <h2><SectionAnchor id="find-a-district" />Find a district</h2>
    <p class="note">
      All {count(s.districts)} are in the <a href="/districts">district index</a>, which sorts and
      filters by name or IRN. These are the ones most often asked about.
    </p>
    <div class="flags">
      {NOTABLE.map((d) => <a class="flag" href={routes.district(d!.irn)}>{d!.name}</a>)}
    </div>
  </div>

  <div class="card" id="three-questions" data-part="three-questions">
    <h2><SectionAnchor id="three-questions" />Three questions this site is built to answer</h2>
    <div class="scroll">
      <table class="prose">
        <tbody>
          <tr>
            <th><a href="/districts">What does my district get, and why?</a></th>
            <td>One page per district, with the formula's answer beside the one it receives.</td>
          </tr>
          <tr>
            <th><a href="/scenario">Who would a change actually reach?</a></th>
            <td>
              Move a lever and re-run the formula across all {count(s.districts)} districts, with
              the count it fails to reach beside the total it costs.
            </td>
          </tr>
          <tr>
            <th><a href="/outcomes">Does any of it show up in outcomes?</a></th>
            <td>
              Poverty explains Ohio's attainment measure at {
                s.outcomes ? s.outcomes.poverty_vs_performance.toFixed(3) : "—"
              }. Every other association on this site is shown against that.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="note">
      Every counterfactual on this site is computed rather than quoted, and checked against{" "}
      <code>crates/project</code> before the site is allowed to build: each reference scenario has
      to reproduce to within a dollar across seven billion, or there is no deploy.{" "}
      <a href="/method">How that works</a>.
    </p>
  </div>

  {/*
    Read from `nav()`, not written here. A front door and a section bar that can disagree about
    what the site contains is the navigability defect this page exists to fix, and a hand-written
    list is exactly how they come to disagree — a section added to one is added to the other only
    if somebody remembers. `tests/unit/nav.spec.ts` asserts the two carry the same groups.
  */}
  <div class="card" id="sections" data-part="sections">
    <h2><SectionAnchor id="sections" />The five sections</h2>
    <div class="scroll">
      <table class="prose">
        <tbody>
          {
            sections.map((group) => (
              <tr>
                <th><a href={group.front}>{group.label}</a></th>
                <td>{group.blurb}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</Base>
