---
/**
 * The statewide summary, and the front door.
 *
 * This used to be a tab. It is the root now because it is the only view that answers a question a
 * reader can have before they have chosen a district — who is on the guarantee, whether state aid
 * offsets property wealth, and what the two floors do.
 */
import BasisToggle from "../components/BasisToggle.astro";
import Base from "../layouts/Base.astro";
import { loadFeed } from "../lib/feed.ts";
import { count, millions } from "../lib/format.ts";
import { baseYear } from "../lib/real.ts";
import * as routes from "../lib/routes.ts";
import { renderStatewideFinances, renderStatewideStructure } from "../lib/statewide.ts";

const { bundle, alphabetical } = loadFeed();
const s = bundle.statewide;
const base = bundle.deflator ? baseYear(bundle.deflator) : null;

/** The districts a reader is most likely to be looking for, as a way in that is not a table. */
const NOTABLE = ["043802", "043786", "044909", "049056", "044933", "045583"]
  .map((irn) => alphabetical.find((d) => d.irn === irn))
  .filter((d) => d != null);
---

<Base
  title="Statewide"
  description={`Ohio pays ${millions(s.realized_aid_total).replace("+", "")} in state foundation aid across ${s.districts} districts in FY${bundle.fiscal_year}. ${s.on_guarantee} of them are funded by the guarantee rather than the formula.`}
  section="statewide"
>
  <h1>Ohio school funding</h1>
  <p class="sub">
    What the Fair School Funding Plan computes for a district, what it actually receives, and what
    a different decision would do. Figures are the Department of Education and Workforce's own FY{
      bundle.fiscal_year
    } model, re-run here rather than quoted.
  </p>

  <Fragment set:html={renderStatewideStructure(bundle)} />

  <BasisToggle id="statewide-basis" base={base}>
    <Fragment slot="nominal" set:html={renderStatewideFinances(bundle, "nominal")} />
    <Fragment slot="real" set:html={renderStatewideFinances(bundle, "real")} />
  </BasisToggle>

  <div class="card">
    <h2>Find a district</h2>
    <p class="note">
      All {count(s.districts)} are in the <a href="/districts">district index</a>, which sorts and
      filters. These are the ones most often asked about.
    </p>
    <div class="flags">
      {NOTABLE.map((d) => <a class="flag" href={routes.district(d!.irn)}>{d!.name}</a>)}
    </div>
  </div>

  <div class="card">
    <h2>Three questions this site is built to answer</h2>
    <div class="scroll">
      <table class="prose">
        <tbody>
          <tr>
            <th><a href="/districts">What does my district get, and why?</a></th>
            <td>One page per district, with the formula's answer beside the one it receives.</td>
          </tr>
          <tr>
            <th><a href="/scenario">Who would a change actually reach?</a></th>
            <td>
              Move a lever and re-run the formula across all {count(s.districts)} districts, with
              the count it fails to reach beside the total it costs.
            </td>
          </tr>
          <tr>
            <th><a href="/outcomes">Does any of it show up in outcomes?</a></th>
            <td>
              Poverty explains Ohio's attainment measure at {
                s.outcomes ? s.outcomes.poverty_vs_performance.toFixed(3) : "—"
              }. Every other association on this site is shown against that.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="note">
      The formula is re-derived here rather than quoted, and it is checked against
      <code>crates/project</code> before this site is allowed to build: every reference scenario
      has to reproduce to within a dollar across seven billion, or there is no deploy.{" "}
      <a href="/method">How that works</a>.
    </p>
  </div>
</Base>
